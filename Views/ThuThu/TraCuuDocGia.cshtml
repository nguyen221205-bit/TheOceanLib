@model List<DoAn_LTWeb.Models.DTOs.DocGiaTraCuuItemDto>

@{
    Layout = "~/Views/Shared/_LayoutThuThu.cshtml";
    string searchQuery = ViewBag.SearchQuery as string;
    string statusFilter = ViewBag.StatusFilter as string;
}

<div class="container-fluid px-0">
    <!-- --- TIÊU ĐỀ TRANG --- -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 text-primary fw-bold">Tra Cứu & Quản Lý Thẻ Độc Giả</h2>
            <p class="text-secondary mb-0">Tìm kiếm nhanh độc giả, kiểm tra lịch sử mượn phạt và bật/tắt trạng thái hoạt động thẻ.</p>
        </div>
        <div>
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="location.href='@Url.Action("TraCuuDocGia", "ThuThu")'">
                <i class="fa-solid fa-rotate me-1"></i> Làm mới danh sách
            </button>
        </div>
    </div>

    <!-- --- CARD THỐNG KÊ NHANH --- -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary-soft p-3 text-primary fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div>
                    <div class="text-secondary small fw-semibold">Tổng Độc Giả Thư Viện</div>
                    <div class="fs-4 fw-bold text-primary">@(ViewBag.TongDocGia ?? 0) người</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background: rgba(16, 185, 129, 0.15); color: #10b981;">
                    <i class="fa-solid fa-id-card"></i>
                </div>
                <div>
                    <div class="text-secondary small fw-semibold">Thẻ Đang Hoạt Động</div>
                    <div class="fs-4 fw-bold" style="color: #10b981;">@(ViewBag.TheHoatDong ?? 0) thẻ</div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-4">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 fs-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px; background: rgba(239, 68, 68, 0.15); color: #ef4444;">
                    <i class="fa-solid fa-user-lock"></i>
                </div>
                <div>
                    <div class="text-secondary small fw-semibold">Thẻ Đang Bị Khóa</div>
                    <div class="fs-4 fw-bold text-danger">@(ViewBag.TheBiKhoa ?? 0) thẻ</div>
                </div>
            </div>
        </div>
    </div>

    <!-- --- FORM TÌM KIẾM & BẢNG DANH SÁCH --- -->
    <div class="glass-card p-4">
        <!-- Thanh Tìm kiếm & Bộ lọc -->
        <form method="get" action="@Url.Action("TraCuuDocGia", "ThuThu")" class="row g-3 mb-4">
            <div class="col-12 col-md-7 col-lg-8">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted" style="border-color: var(--border-color);"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="q" class="form-control bg-transparent border-start-0" placeholder="Nhập Mã độc giả (#DG), Họ tên, Số điện thoại, Email..." value="@searchQuery" style="border-color: var(--border-color); color: var(--text-primary);" />
                </div>
            </div>
            <div class="col-12 col-md-3 col-lg-2">
                <select name="status" class="form-select bg-transparent" style="border-color: var(--border-color); color: var(--text-primary);">
                    <option value="" style="background: var(--bg-surface); color: var(--text-primary);">-- Tất cả thẻ --</option>
                    <option value="active" selected="@(statusFilter == "active")" style="background: var(--bg-surface); color: var(--text-primary);">Hoạt động</option>
                    <option value="locked" selected="@(statusFilter == "locked")" style="background: var(--bg-surface); color: var(--text-primary);">Đã khóa</option>
                </select>
            </div>
            <div class="col-12 col-md-2 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill w-100"><i class="fa-solid fa-filter me-1"></i> Lọc</button>
                @if (!string.IsNullOrEmpty(searchQuery) || !string.IsNullOrEmpty(statusFilter))
                {
                    <a href="@Url.Action("TraCuuDocGia", "ThuThu")" class="btn btn-outline-secondary rounded-pill" title="Xóa bộ lọc"><i class="fa-solid fa-xmark"></i></a>
                }
            </div>
        </form>

        <!-- Bảng Độc giả -->
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0" id="readersTable">
                <thead>
                    <tr>
                        <th style="width: 90px; text-align: center;">Mã Thẻ</th>
                        <th style="text-align: left;">Độc Giả</th>
                        <th style="text-align: left;">SĐT / Email</th>
                        <th style="width: 140px; text-align: center;">Lượt Mượn</th>
                        <th style="width: 150px; text-align: center;">Nợ Phạt</th>
                        <th style="width: 140px; text-align: center;">Trạng Thái Thẻ</th>
                        <th style="width: 140px; text-align: center;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="fa-solid fa-user-slash fs-1 mb-3 text-muted" style="opacity: 0.4;"></i>
                                <p class="mb-0 fw-semibold">Không tìm thấy độc giả nào phù hợp!</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            bool isLocked = item.TrangThaiThe == "Đã khóa" || item.TrangThaiThe == "Locked";
                            <tr id="row-docgia-@item.MaNguoiDung">
                                <td class="text-center fw-bold text-primary">#DG@(item.MaNguoiDung)</td>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 38px; height: 38px; font-size: 0.95rem; background: linear-gradient(135deg, #0ea5e9, #6366f1);">
                                            @string.Concat(item.HoTen.Split(' ').Last().Take(1))
                                        </div>
                                        <div>
                                            <div class="fw-bold text-primary-light">@item.HoTen</div>
                                            <div class="small text-muted"><i class="fa-regular fa-clock me-1"></i>Tham gia: @(item.NgayTao.HasValue ? item.NgayTao.Value.ToString("dd/MM/yyyy") : "N/A")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-start small">
                                    <div><i class="fa-solid fa-phone text-muted me-1"></i><strong>@item.SoDienThoai</strong></div>
                                    <div class="text-secondary"><i class="fa-regular fa-envelope text-muted me-1"></i>@item.Email</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-soft text-primary px-3 py-1 rounded-pill fw-semibold">
                                        @item.SoLuotMuon lượt
                                    </span>
                                    @if (item.DangMuonCount > 0)
                                    {
                                        <div class="extra-small text-success mt-1"><i class="fa-solid fa-book-open me-1"></i>Đang giữ @item.DangMuonCount cuốn</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TongPhatChuaNop > 0)
                                    {
                                        <span class="badge bg-danger-soft text-danger px-3 py-1 rounded-pill fw-bold">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i>@item.TongPhatChuaNop.ToString("N0") VNĐ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-soft text-success px-3 py-1 rounded-pill">
                                            <i class="fa-solid fa-circle-check me-1"></i>Không nợ
                                        </span>
                                    }
                                </td>
                                <td class="text-center" id="status-cell-@item.MaNguoiDung">
                                    @if (isLocked)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold">
                                            <i class="fa-solid fa-lock me-1"></i>Đã khóa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold">
                                            <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3 btn-view-profile" data-id="@item.MaNguoiDung">
                                        <i class="fa-regular fa-eye me-1"></i> Hồ sơ
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- --- MODAL POPUP HỒ SƠ ĐỘC GIẢ 3 TAB --- -->
<div class="modal fade" id="docGiaDetailModal" tabindex="-1" aria-labelledby="docGiaDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content glass-card" style="background-color: var(--bg-surface-glass, #0f172a); backdrop-filter: blur(20px); border: 1px solid var(--border-color); border-radius: 20px; overflow: hidden;">
            <!-- Header Modal -->
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-lg" style="width: 50px; height: 50px; font-size: 1.3rem; background: linear-gradient(135deg, #0ea5e9, #6366f1);" id="modalUserAvatar">
                        DG
                    </div>
                    <div>
                        <h5 class="modal-title text-primary fw-bold mb-0" id="modalUserHoTen">Họ và Tên Độc Giả</h5>
                        <div class="small text-secondary">Thẻ Độc Giả <span id="modalUserMa" class="fw-bold text-info">#DG0</span></div>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Header Nav Tabs -->
            <div class="px-4 pt-3 border-bottom" style="border-color: var(--border-color) !important;">
                <ul class="nav nav-tabs border-bottom-0" id="profileTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="tab-info-link" data-bs-toggle="tab" data-bs-target="#tab-info" type="button" role="tab">
                            <i class="fa-regular fa-id-card me-2"></i>Thông Tin & Thẻ
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-loans-link" data-bs-toggle="tab" data-bs-target="#tab-loans" type="button" role="tab">
                            <i class="fa-solid fa-book-bookmark me-2"></i>Lịch Sử Mượn Trả (<span id="countLoans">0</span>)
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="tab-fines-link" data-bs-toggle="tab" data-bs-target="#tab-fines" type="button" role="tab">
                            <i class="fa-solid fa-file-invoice-dollar me-2"></i>Phiếu Phạt Vi Phạm (<span id="countFines">0</span>)
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Body Modal Content -->
            <div class="modal-body p-4">
                <div class="tab-content" id="profileTabContent">
                    <!-- TAB 1: THÔNG TIN VÀ THẺ -->
                    <div class="tab-pane fade show active" id="tab-info" role="tabpanel">
                        <div class="row g-4">
                            <div class="col-12 col-md-7">
                                <div class="p-3 rounded-4" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                                    <h6 class="text-primary fw-bold mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                                        <i class="fa-regular fa-user me-2"></i>Thông Tin Chi Tiết
                                    </h6>
                                    <table class="table table-borderless table-sm mb-0 text-secondary">
                                        <tr>
                                            <td style="width: 140px;" class="fw-semibold">Mã độc giả:</td>
                                            <td id="infoModalMa" class="fw-bold text-primary">#DG000</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">Họ và Tên:</td>
                                            <td id="infoModalTen" class="fw-bold text-primary-light">--</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">Số điện thoại:</td>
                                            <td id="infoModalSdt" class="fw-bold text-info">--</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">Địa chỉ Email:</td>
                                            <td id="infoModalEmail">--</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">Địa chỉ cư trú:</td>
                                            <td id="infoModalDiaChi">--</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-semibold">Ngày tham gia:</td>
                                            <td id="infoModalNgayTao">--</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <div class="col-12 col-md-5">
                                <div class="p-4 rounded-4 text-center d-flex flex-column align-items-center justify-content-center h-100" style="background: rgba(14, 165, 233, 0.05); border: 1px solid rgba(14, 165, 233, 0.2);">
                                    <div class="mb-3">
                                        <span class="text-secondary small fw-semibold d-block mb-1">Trạng thái thẻ thư viện</span>
                                        <div id="modalStatusBadge">
                                            <span class="badge bg-success rounded-pill px-4 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</span>
                                        </div>
                                    </div>
                                    <p class="small text-secondary mb-4">Thủ thư có thể khóa thẻ của độc giả khi có hành vi vi phạm nặng hoặc nợ phạt chưa thanh toán.</p>
                                    <button type="button" class="btn btn-danger rounded-pill px-4 bg-gradient w-100 shadow-sm" id="btnToggleCardStatus">
                                        <i class="fa-solid fa-lock me-2"></i>Khóa Thẻ Độc Giả
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- TAB 2: LỊCH SỬ MƯỢN TRẢ -->
                    <div class="tab-pane fade" id="tab-loans" role="tabpanel">
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table align-middle table-sm" id="tableModalLoans">
                                <thead>
                                    <tr>
                                        <th>Mã Phiếu</th>
                                        <th>Ngày Mượn</th>
                                        <th>Ngày Hẹn Trả</th>
                                        <th>Sách Mượn</th>
                                        <th>Trạng Thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Render qua JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TAB 3: PHIẾU PHẠT VI PHẠM -->
                    <div class="tab-pane fade" id="tab-fines" role="tabpanel">
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table align-middle table-sm" id="tableModalFines">
                                <thead>
                                    <tr>
                                        <th>Mã Phạt</th>
                                        <th>Ngày Lập</th>
                                        <th>Tên Sách Vi Phạm</th>
                                        <th>Số Tiền Phạt</th>
                                        <th>Lý Do Phạt</th>
                                        <th>Trạng Thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Render qua JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Modal -->
            <div class="modal-footer border-top-0 px-4 pb-4 pt-0 justify-content-end">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            let currentReaderId = 0;
            let currentReaderStatus = '';

            // 1. MỞ MODAL XEM HỒ SƠ ĐỘC GIẢ
            $('.btn-view-profile').on('click', function () {
                const id = $(this).data('id');
                currentReaderId = id;

                // Reset Tab
                const firstTabEl = document.querySelector('#profileTab button[data-bs-target="#tab-info"]');
                const firstTab = new bootstrap.Tab(firstTabEl);
                firstTab.show();

                const modal = new bootstrap.Modal(document.getElementById('docGiaDetailModal'));
                modal.show();

                // Lấy dữ liệu qua AJAX
                $.ajax({
                    url: '/ThuThu/GetDocGiaDetail',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            const d = res.data;
                            currentReaderStatus = d.TrangThaiThe;

                            // Fill thông tin cơ bản
                            $('#modalUserHoTen').text(d.HoTen);
                            $('#modalUserMa').text('#DG' + d.MaNguoiDung);
                            $('#modalUserAvatar').text(d.HoTen ? d.HoTen.split(' ').pop().charAt(0).toUpperCase() : 'D');

                            $('#infoModalMa').text('#DG' + d.MaNguoiDung);
                            $('#infoModalTen').text(d.HoTen);
                            $('#infoModalSdt').text(d.SoDienThoai || 'Chưa cập nhật');
                            $('#infoModalEmail').text(d.Email || 'Chưa cập nhật');
                            $('#infoModalDiaChi').text(d.DiaChi || 'Chưa cập nhật');
                            $('#infoModalNgayTao').text(d.NgayTao ? new Date(parseInt(d.NgayTao.replace('/Date(', '').replace(')/', ''))).toLocaleDateString('vi-VN') : 'N/A');

                            updateCardStatusUI(d.TrangThaiThe);

                            // Render Tab 2: Lịch sử phiếu mượn
                            $('#countLoans').text(d.DanhSachPhieuMuon ? d.DanhSachPhieuMuon.length : 0);
                            const tbodyLoans = $('#tableModalLoans tbody');
                            tbodyLoans.empty();

                            if (d.DanhSachPhieuMuon && d.DanhSachPhieuMuon.length > 0) {
                                d.DanhSachPhieuMuon.forEach(function (pm) {
                                    let booksHtml = '';
                                    if (pm.DanhSachCuonSach && pm.DanhSachCuonSach.length > 0) {
                                        pm.DanhSachCuonSach.forEach(function (b) {
                                            booksHtml += `<div class="small"><i class="fa-solid fa-book text-muted me-1"></i>${b.TenSach} <span class="text-secondary">(#CS${b.MaCuonSach})</span></div>`;
                                        });
                                    }

                                    const ngayMuon = pm.NgayMuon ? new Date(parseInt(pm.NgayMuon.replace('/Date(', '').replace(')/', ''))).toLocaleDateString('vi-VN') : 'N/A';
                                    const ngayHenTra = pm.NgayHenTra ? new Date(parseInt(pm.NgayHenTra.replace('/Date(', '').replace(')/', ''))).toLocaleDateString('vi-VN') : 'N/A';

                                    tbodyLoans.append(`
                                        <tr>
                                            <td class="fw-bold text-primary">#PM${pm.MaPhieuMuon}</td>
                                            <td>${ngayMuon}</td>
                                            <td>${ngayHenTra}</td>
                                            <td>${booksHtml}</td>
                                            <td><span class="badge ${pm.TrangThai === 'Đang mượn' ? 'bg-warning text-dark' : 'bg-success'} rounded-pill">${pm.TrangThai}</span></td>
                                        </tr>
                                    `);
                                });
                            } else {
                                tbodyLoans.append('<tr><td colspan="5" class="text-center py-4 text-muted">Độc giả chưa có lịch sử mượn sách.</td></tr>');
                            }

                            // Render Tab 3: Phiếu phạt
                            $('#countFines').text(d.DanhSachPhieuPhat ? d.DanhSachPhieuPhat.length : 0);
                            const tbodyFines = $('#tableModalFines tbody');
                            tbodyFines.empty();

                            if (d.DanhSachPhieuPhat && d.DanhSachPhieuPhat.length > 0) {
                                d.DanhSachPhieuPhat.forEach(function (fp) {
                                    const isPaid = fp.TrangThaiThanhToan === 'DaThanhToan' || fp.TrangThaiThanhToan === 'Đã thanh toán';
                                    const ngayLap = fp.NgayLap ? new Date(parseInt(fp.NgayLap.replace('/Date(', '').replace(')/', ''))).toLocaleDateString('vi-VN') : 'N/A';

                                    tbodyFines.append(`
                                        <tr>
                                            <td class="fw-bold text-danger">#PP${fp.MaPhieuPhat}</td>
                                            <td>${ngayLap}</td>
                                            <td class="fw-semibold">${fp.TenSach}</td>
                                            <td class="fw-bold text-danger">${fp.SoTienPhat.toLocaleString()} VNĐ</td>
                                            <td class="small text-secondary">${fp.LyDoPhat || 'Không có'}</td>
                                            <td>
                                                ${isPaid ? '<span class="badge bg-success rounded-pill">Đã nộp phạt</span>' : '<span class="badge bg-danger rounded-pill">Chưa thanh toán</span>'}
                                            </td>
                                        </tr>
                                    `);
                                });
                            } else {
                                tbodyFines.append('<tr><td colspan="6" class="text-center py-4 text-muted">Độc giả chưa có phiếu phạt vi phạm nào.</td></tr>');
                            }

                        } else {
                            showToast(res.message || 'Không thể lấy thông tin độc giả', 'fa-solid fa-circle-exclamation');
                        }
                    },
                    error: function () {
                        showToast('Lỗi kết nối máy chủ.', 'fa-solid fa-triangle-exclamation');
                    }
                });
            });

            // 2. KHÓA / MỞ KHÓA THẺ ĐỘC GIẢ
            $('#btnToggleCardStatus').on('click', function () {
                const isCurrentlyLocked = currentReaderStatus === 'Đã khóa' || currentReaderStatus === 'Locked';
                const confirmMsg = isCurrentlyLocked ?
                    `Bạn có chắc chắn muốn MỞ KHÓA THẺ cho độc giả #${currentReaderId}?` :
                    `Bạn có chắc chắn muốn KHÓA THẺ độc giả #${currentReaderId}? Độc giả sẽ không thể đăng ký mượn sách mới.`;

                if (confirm(confirmMsg)) {
                    $.ajax({
                        url: '/ThuThu/DoiTrangThaiThe',
                        type: 'POST',
                        data: { id: currentReaderId },
                        success: function (res) {
                            if (res.success) {
                                currentReaderStatus = res.newStatus;
                                updateCardStatusUI(res.newStatus);
                                showToast(res.message, 'fa-solid fa-circle-check');

                                // Cập nhật dòng tương ứng ngoài bảng
                                const cell = $(`#status-cell-${currentReaderId}`);
                                if (res.newStatus === 'Đã khóa' || res.newStatus === 'Locked') {
                                    cell.html('<span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold"><i class="fa-solid fa-lock me-1"></i>Đã khóa</span>');
                                } else {
                                    cell.html('<span class="badge bg-success rounded-pill px-3 py-1.5 fw-bold"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</span>');
                                }
                            } else {
                                showToast(res.message || 'Lỗi đổi trạng thái thẻ', 'fa-solid fa-triangle-exclamation');
                            }
                        },
                        error: function () {
                            showToast('Lỗi kết nối máy chủ khi khóa/mở thẻ.', 'fa-solid fa-triangle-exclamation');
                        }
                    });
                }
            });

            function updateCardStatusUI(status) {
                const isLocked = status === 'Đã khóa' || status === 'Locked';
                if (isLocked) {
                    $('#modalStatusBadge').html('<span class="badge bg-danger rounded-pill px-4 py-2 fs-6"><i class="fa-solid fa-lock me-1"></i>Đã khóa</span>');
                    $('#btnToggleCardStatus').removeClass('btn-danger').addClass('btn-success').html('<i class="fa-solid fa-lock-open me-2"></i>Mở Khóa Thẻ Độc Giả');
                } else {
                    $('#modalStatusBadge').html('<span class="badge bg-success rounded-pill px-4 py-2 fs-6"><i class="fa-solid fa-circle-check me-1"></i>Hoạt động</span>');
                    $('#btnToggleCardStatus').removeClass('btn-success').addClass('btn-danger').html('<i class="fa-solid fa-lock me-2"></i>Khóa Thẻ Độc Giả');
                }
            }
        });
    </script>
}
