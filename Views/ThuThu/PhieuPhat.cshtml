@model List<DoAn_LTWeb.Models.DTOs.PhieuPhatQuanLyDto>

@{
    Layout = "~/Views/Shared/_LayoutThuThu.cshtml";
    ViewBag.Title = "Quản lý phiếu phạt vi phạm";
    
    int totalCount = Model != null ? Model.Count : 0;
    int unpaidCount = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "ChuaThanhToan") : 0;
    int paidCount = Model != null ? Model.Count(x => x.TrangThaiThanhToan == "DaThanhToan") : 0;
    decimal unpaidTotalAmount = Model != null ? Model.Where(x => x.TrangThaiThanhToan == "ChuaThanhToan").Sum(x => x.SoTienPhat) : 0;
}

<style>
    /* CSS In ấn chuyên nghiệp cho Phiếu Phạt */
    @@media print {
        body * {
            visibility: hidden;
        }
        #printableTicketArea, #printableTicketArea * {
            visibility: visible;
        }
        #printableTicketArea {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            padding: 20px;
            color: #000 !important;
            background: #fff !important;
        }
        .no-print {
            display: none !important;
        }
    }
</style>

<div class="container-fluid p-0">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-file-invoice-dollar text-emerald me-2"></i>Quản Lý Phiếu Phạt
            </h3>
            <p class="text-muted small mb-0">Theo dõi, thu tiền phạt vi phạm hỏng/mất sách và in hóa đơn phạt cho độc giả.</p>
        </div>
    </div>

    <!-- STATS OVERVIEW CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="glass-card p-3 rounded-4 border d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger fs-4" style="width: 54px; height: 54px;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium d-block">Tổng tiền chưa thu</span>
                    <h4 class="fw-bold mb-0 text-danger">@unpaidTotalAmount.ToString("#,##0") <small class="fs-6">VNĐ</small></h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="glass-card p-3 rounded-4 border d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning fs-4" style="width: 54px; height: 54px;">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium d-block">Phiếu chưa thanh toán</span>
                    <h4 class="fw-bold mb-0 text-warning">@unpaidCount <small class="fs-6">phiếu</small></h4>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="glass-card p-3 rounded-4 border d-flex align-items-center gap-3">
                <div class="rounded-circle p-3 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success fs-4" style="width: 54px; height: 54px;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div>
                    <span class="text-muted small fw-medium d-block">Phiếu đã hoàn tất</span>
                    <h4 class="fw-bold mb-0 text-success">@paidCount <small class="fs-6">phiếu</small></h4>
                </div>
            </div>
        </div>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="glass-card p-3 rounded-4 border mb-4">
        <div class="row g-3 align-items-center justify-content-between">
            <div class="col-12 col-md-auto">
                <ul class="nav nav-pills custom-nav-pills gap-2" id="fineStatusTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill px-3 py-1.5 small fw-semibold" data-status="all" type="button">
                            Tất cả <span class="badge bg-secondary rounded-pill ms-1">@totalCount</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-3 py-1.5 small fw-semibold text-warning" data-status="ChuaThanhToan" type="button">
                            <i class="fa-solid fa-circle-exclamation me-1"></i>Chưa thanh toán <span class="badge bg-warning bg-opacity-20 text-warning rounded-pill ms-1">@unpaidCount</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill px-3 py-1.5 small fw-semibold text-success" data-status="DaThanhToan" type="button">
                            <i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán <span class="badge bg-success bg-opacity-20 text-success rounded-pill ms-1">@paidCount</span>
                        </button>
                    </li>
                </ul>
            </div>
            <div class="col-12 col-md-5 col-lg-4">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" id="searchInput" class="form-control bg-transparent border-start-0 ps-0" placeholder="Tìm theo tên độc giả, mã phiếu..." />
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE LIST -->
    <div class="glass-card rounded-4 border overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="fineTable">
                <thead class="bg-surface border-bottom" style="color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3">Mã Phiếu Phạt</th>
                        <th class="py-3">Mã Phiếu Mượn</th>
                        <th class="py-3">Độc Giả</th>
                        <th class="py-3 text-center">Chi Tiết Vi Phạm</th>
                        <th class="py-3 text-end">Số Tiền Phạt</th>
                        <th class="py-3">Ngày Lập</th>
                        <th class="py-3 text-center">Trạng Thái</th>
                        <th class="pe-4 py-3 text-center">Thanh Toán</th>
                    </tr>
                </thead>
                <tbody style="color: var(--text-primary);">
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr class="empty-row">
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-receipt fs-1 d-block mb-2 text-opacity-50"></i>
                                <span>Chưa có phiếu phạt nào trong cơ sở dữ liệu.</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            bool isPaid = item.TrangThaiThanhToan == "DaThanhToan";
                            <tr class="fine-row" data-status="@item.TrangThaiThanhToan" data-search="@(item.MaPhieuPhat) @(item.MaPhieuMuon) @(item.TenDocGia) @(item.LyDo)">
                                <td class="ps-4 fw-bold text-primary">#PP@(item.MaPhieuPhat)</td>
                                <td class="fw-semibold text-muted">#PM@(item.MaPhieuMuon)</td>
                                <td>
                                    <div class="fw-bold">@item.TenDocGia</div>
                                    <small class="text-muted"><i class="fa-solid fa-phone me-1 fs-7"></i>@item.SoDienThoai</small>
                                </td>
                                <td class="text-center">
                                    <!-- Nút Chi Tiết Vi Phạm thay cho văn bản dài -->
                                    <button type="button" class="btn btn-sm btn-outline-info rounded-pill px-3 py-1 btn-detail" data-id="@item.MaPhieuPhat" title="Xem lý do và sách vi phạm">
                                        <i class="fa-solid fa-circle-info me-1"></i>Chi tiết
                                    </button>
                                </td>
                                <td class="text-end fw-bold fs-6 @(isPaid ? "text-success" : "text-danger")">
                                    @item.SoTienPhat.ToString("#,##0") đ
                                </td>
                                <td class="small text-muted">@item.NgayLap</td>
                                <td class="text-center">
                                    @if (isPaid)
                                    {
                                        <span class="status-badge paid">
                                            <i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge unpaid">
                                            <i class="fa-solid fa-clock me-1"></i>Chưa thanh toán
                                        </span>
                                    }
                                </td>
                                <td class="pe-4 text-center">
                                    <div class="d-flex justify-content-center align-items-center">
                                        <!-- Nút Thanh toán / Nút Đã thanh toán bị khóa xám -->
                                        @if (!isPaid)
                                        {
                                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3 btn-pay" data-id="@item.MaPhieuPhat" data-amount="@item.SoTienPhat" data-name="@item.TenDocGia" title="Thanh toán phiếu phạt">
                                                <i class="fa-solid fa-money-bill-wave me-1"></i>Thanh toán
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-secondary opacity-50 rounded-pill px-3" disabled title="Phiếu phạt đã được thanh toán">
                                                <i class="fa-solid fa-check me-1"></i>Đã thanh toán
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL XEM CHI TIẾT PHIẾU PHẠT ================= -->
<div class="modal fade" id="fineDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom border-light">
                <h5 class="modal-title fw-bold text-primary">
                    <i class="fa-solid fa-receipt me-2"></i>Chi Tiết Phiếu Phạt <span id="mdPhatId" class="text-muted"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3 mb-4 p-3 bg-surface rounded-3 border">
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Độc giả</small>
                        <strong id="mdDocGia" class="text-emerald">---</strong>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Số điện thoại</small>
                        <span id="mdSdt">---</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Mã Phiếu Mượn</small>
                        <span id="mdPhieuMuon" class="fw-bold text-primary">---</span>
                    </div>
                    <div class="col-6 col-md-3">
                        <small class="text-muted d-block">Trạng thái thanh toán</small>
                        <span id="mdTrangThaiBadge">---</span>
                    </div>
                </div>

                <h6 class="fw-bold mb-2" style="color: var(--text-primary);"><i class="fa-solid fa-book me-2 text-primary"></i>Thông tin sách vi phạm</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-bordered align-middle text-sm mb-0">
                        <thead class="bg-surface">
                            <tr>
                                <th>Tên Sách Vi Phạm</th>
                                <th>Mã Cuốn Sách</th>
                                <th>Tình Trạng Khi Trả</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td id="mdTenSach" class="fw-semibold">---</td>
                                <td id="mdMaCuonSach" class="text-center">---</td>
                                <td id="mdTinhTrang" class="text-danger fw-semibold">---</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="p-3 bg-danger bg-opacity-10 border border-danger border-opacity-20 rounded-3 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="text-muted small d-block">Lý do phạt:</span>
                        <strong id="mdLyDo" class="text-danger">---</strong>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Tổng số tiền phạt:</span>
                        <h4 id="mdTienPhat" class="fw-bold text-danger mb-0">0 đ</h4>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="btnModalPrintFromDetail">
                    <i class="fa-solid fa-print me-1"></i>In Phiếu Phạt
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL XÁC NHẬN THANH TOÁN (TIỀN MẶT / CHUYỂN KHOẢN QR) ================= -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom border-light">
                <h5 class="modal-title fw-bold text-success">
                    <i class="fa-solid fa-credit-card me-2"></i>Xác Nhận Thanh Toán Phiếu Phạt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <input type="hidden" id="payFineId" />
                
                <p class="text-muted mb-1">Xác nhận thu tiền phạt cho phiếu <strong id="payFineTitle" class="text-primary">#PP---</strong></p>
                <h2 id="payAmountText" class="fw-bold text-danger mb-4">0 đ</h2>

                <label class="form-label fw-semibold text-start d-block mb-2">Chọn phương thức thanh toán:</label>
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <input type="radio" class="btn-check" name="payMethod" id="payMethodCash" value="TienMat" checked>
                        <label class="btn btn-outline-success w-100 py-3 rounded-3" for="payMethodCash">
                            <i class="fa-solid fa-money-bill-1-wave fs-3 d-block mb-1"></i>
                            <span class="fw-bold small">Tiền mặt</span>
                        </label>
                    </div>
                    <div class="col-6">
                        <input type="radio" class="btn-check" name="payMethod" id="payMethodQR" value="ChuyenKhoan">
                        <label class="btn btn-outline-primary w-100 py-3 rounded-3" for="payMethodQR">
                            <i class="fa-solid fa-qrcode fs-3 d-block mb-1"></i>
                            <span class="fw-bold small">Mã QR Chuyển Khoản</span>
                        </label>
                    </div>
                </div>

                <!-- Khung hiển thị Mã QR VietQR khi chọn chuyển khoản -->
                <div id="qrContainer" class="d-none p-3 bg-white rounded-3 border mb-3 text-dark">
                    <small class="text-muted d-block mb-2">Quét mã QR qua ngân hàng để thanh toán:</small>
                    <img id="qrImage" src="" alt="QR Thanh toán" style="max-width: 200px; height: auto;" class="img-fluid rounded border p-1" />
                    <div class="mt-2 small">
                        <div>Ngân hàng: <strong>MBBank</strong></div>
                        <div>Số tài khoản: <strong>09123456789</strong></div>
                        <div>Chủ tài khoản: <strong>THU VIEN THEOCEANLIB</strong></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-light">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" id="btnConfirmPayment">
                    <i class="fa-solid fa-check me-1"></i>Xác Nhận Đã Thu Tiền
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL IN PHIẾU PHẠT (PRINT PREVIEW) ================= -->
<div class="modal fade" id="printModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom border-light no-print">
                <h5 class="modal-title fw-bold text-primary">
                    <i class="fa-solid fa-print me-2"></i>Xem Trước Hóa Đơn Phạt
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="printableTicketArea">
                <!-- Nội dung phiếu phạt chuẩn in ấn -->
                <div class="text-center mb-4 border-bottom pb-3">
                    <h3 class="fw-bold mb-1 text-uppercase">THƯ VIỆN THEOCEANLIB</h3>
                    <p class="mb-1 text-muted small">Địa chỉ: 123 Đường Thư Viện, Q. Tân Phú, TP. Hồ Chí Minh</p>
                    <p class="mb-0 text-muted small">Hotline: (028) 3811 9999 | Email: contact@theoceanlib.edu.vn</p>
                    <h4 class="fw-bold mt-3 text-danger text-uppercase">PHIẾU XỬ LÝ VI PHẠM & PHẠT</h4>
                    <span class="badge bg-outline-dark border text-dark">Mã phiếu phạt: #PP<span id="prPhatId">---</span></span>
                </div>

                <div class="row g-3 mb-4 fs-6">
                    <div class="col-6">
                        <div><strong>Họ tên độc giả:</strong> <span id="prTenDocGia">---</span></div>
                        <div><strong>Số điện thoại:</strong> <span id="prSdt">---</span></div>
                    </div>
                    <div class="col-6 text-end">
                        <div><strong>Mã Phiếu Mượn:</strong> #PM<span id="prPhieuMuon">---</span></div>
                        <div><strong>Ngày lập phiếu:</strong> <span id="prNgayLap">---</span></div>
                    </div>
                </div>

                <table class="table table-bordered align-middle mb-4">
                    <thead class="table-light text-uppercase small">
                        <tr>
                            <th>Nội dung vi phạm / Sách</th>
                            <th class="text-center" style="width: 150px;">Tình trạng</th>
                            <th class="text-end" style="width: 180px;">Số tiền phạt</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <strong id="prTenSach">---</strong><br/>
                                <small class="text-muted">Lý do: <span id="prLyDo">---</span></small>
                            </td>
                            <td class="text-center text-danger fw-bold" id="prTinhTrang">---</td>
                            <td class="text-end fw-bold text-danger fs-5" id="prTienPhat">0 đ</td>
                        </tr>
                    </tbody>
                </table>

                <div class="d-flex justify-content-between align-items-center p-3 border rounded-3 bg-light mb-4">
                    <div>
                        <strong>Trạng thái thanh toán:</strong> 
                        <span id="prTrangThai" class="fw-bold text-danger">Chưa thanh toán</span>
                    </div>
                    <div>
                        <strong>TỔNG TIỀN PHẠT:</strong> 
                        <span id="prTongTien" class="fw-bold text-danger fs-4 ms-2">0 đ</span>
                    </div>
                </div>

                <div class="row text-center mt-5 pt-3">
                    <div class="col-6">
                        <p class="fw-bold mb-5">ĐỘC GIẢ VI PHẠM<br/><small class="fw-normal text-muted">(Ký và ghi rõ họ tên)</small></p>
                    </div>
                    <div class="col-6">
                        <p class="fw-bold mb-5">THỦ THƯ XỬ LÝ<br/><small class="fw-normal text-muted">(Ký và ghi rõ họ tên)</small></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top border-light no-print">
                <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="window.print();">
                    <i class="fa-solid fa-print me-1"></i>Xác Nhận In Phiếu
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // 1. Lọc theo Tab trạng thái
            $('#fineStatusTabs button').on('click', function () {
                $('#fineStatusTabs button').removeClass('active');
                $(this).addClass('active');

                const status = $(this).data('status');
                filterRows(status, $('#searchInput').val());
            });

            // 2. Tìm kiếm tự động
            $('#searchInput').on('keyup', function () {
                const activeStatus = $('#fineStatusTabs button.active').data('status');
                filterRows(activeStatus, $(this).val());
            });

            function filterRows(status, query) {
                query = (query || '').toLowerCase().trim();

                $('#fineTable tbody tr.fine-row').each(function () {
                    const rowStatus = $(this).data('status');
                    const rowSearch = ($(this).data('search') || '').toLowerCase();

                    const matchStatus = (status === 'all' || rowStatus === status);
                    const matchSearch = (!query || rowSearch.indexOf(query) !== -1);

                    if (matchStatus && matchSearch) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            }

            // 3. Mở Modal Xem Chi Tiết Phiếu Phạt
            $('.btn-detail').on('click', function () {
                const id = $(this).data('id');
                loadFineDetail(id, function(data) {
                    $('#mdPhatId').text('#PP' + data.MaPhieuPhat);
                    $('#mdDocGia').text(data.TenDocGia);
                    $('#mdSdt').text(data.SoDienThoai);
                    $('#mdPhieuMuon').text('#PM' + data.MaPhieuMuon);
                    $('#mdTenSach').text(data.TenSach);
                    $('#mdMaCuonSach').text('#CS' + data.MaCuonSach);
                    $('#mdTinhTrang').text(data.TinhTrangKhiTra);
                    $('#mdLyDo').text(data.LyDo);
                    $('#mdTienPhat').text(formatMoney(data.SoTienPhat) + ' đ');

                    if (data.TrangThaiThanhToan === 'DaThanhToan') {
                        $('#mdTrangThaiBadge').html('<span class="status-badge paid"><i class="fa-solid fa-circle-check me-1"></i>Đã thanh toán</span>');
                    } else {
                        $('#mdTrangThaiBadge').html('<span class="status-badge unpaid"><i class="fa-solid fa-clock me-1"></i>Chưa thanh toán</span>');
                    }

                    $('#btnModalPrintFromDetail').data('id', data.MaPhieuPhat);
                    $('#fineDetailModal').modal('show');
                });
            });

            // 4. Mở Modal Thanh Toán
            $('.btn-pay').on('click', function () {
                const id = $(this).data('id');
                const amount = $(this).data('amount');
                const name = $(this).data('name');

                $('#payFineId').val(id);
                $('#payFineTitle').text('#PP' + id);
                $('#payAmountText').text(formatMoney(amount) + ' đ');
                $('#payMethodCash').prop('checked', true);
                $('#qrContainer').addClass('d-none');

                // Tạo QR VietQR tự động
                const qrUrl = `https://img.vietqr.io/image/mb-09123456789-compact2.png?amount=${amount}&addInfo=THANH%20TOAN%20PHIEU%20PHAT%20PP${id}&accountName=THU%20VIEN%20THEOCEANLIB`;
                $('#qrImage').attr('src', qrUrl);

                $('#paymentModal').modal('show');
            });

            // Đổi lựa chọn phương thức thanh toán
            $('input[name="payMethod"]').on('change', function() {
                if ($(this).val() === 'ChuyenKhoan') {
                    $('#qrContainer').removeClass('d-none');
                } else {
                    $('#qrContainer').addClass('d-none');
                }
            });

            // Xác nhận thu tiền phạt
            $('#btnConfirmPayment').on('click', function () {
                const id = $('#payFineId').val();
                const method = $('input[name="payMethod"]:checked').val();

                $.ajax({
                    url: '@Url.Action("ThanhToanPhieuPhat", "ThuThu")',
                    type: 'POST',
                    data: { MaPhieuPhat: id, PhuongThucThanhToan: method },
                    success: function (res) {
                        if (res.success) {
                            $('#paymentModal').modal('hide');
                            showToast(res.message, 'success');
                            setTimeout(function () {
                                location.reload();
                            }, 1000);
                        } else {
                            showToast(res.message, 'error');
                        }
                    },
                    error: function () {
                        showToast('Lỗi kết nối máy chủ!', 'error');
                    }
                });
            });

            // 5. Mở Modal In Phiếu Phạt
            $('.btn-print, #btnModalPrintFromDetail').on('click', function () {
                const id = $(this).data('id');
                $('#fineDetailModal').modal('hide');

                loadFineDetail(id, function (data) {
                    $('#prPhatId').text(data.MaPhieuPhat);
                    $('#prTenDocGia').text(data.TenDocGia);
                    $('#prSdt').text(data.SoDienThoai);
                    $('#prPhieuMuon').text(data.MaPhieuMuon);
                    $('#prNgayLap').text(data.NgayLap);
                    $('#prTenSach').text(data.TenSach);
                    $('#prLyDo').text(data.LyDo);
                    $('#prTinhTrang').text(data.TinhTrangKhiTra);
                    $('#prTienPhat, #prTongTien').text(formatMoney(data.SoTienPhat) + ' đ');

                    if (data.TrangThaiThanhToan === 'DaThanhToan') {
                        $('#prTrangThai').text('Đã thanh toán').removeClass('text-danger').addClass('text-success');
                    } else {
                        $('#prTrangThai').text('Chưa thanh toán').removeClass('text-success').addClass('text-danger');
                    }

                    $('#printModal').modal('show');
                });
            });

            // Utility Functions
            function loadFineDetail(id, callback) {
                $.ajax({
                    url: '@Url.Action("GetPhieuPhatDetail", "ThuThu")',
                    type: 'GET',
                    data: { id: id },
                    success: function (res) {
                        if (res.success) {
                            callback(res.data);
                        } else {
                            showToast(res.message, 'error');
                        }
                    },
                    error: function () {
                        showToast('Không thể tải chi tiết phiếu phạt!', 'error');
                    }
                });
            }

            function formatMoney(num) {
                return (num || 0).toString().replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1.');
            }

            function showToast(msg, type) {
                if (window.showAppToast) {
                    window.showAppToast(msg, type);
                } else {
                    alert(msg);
                }
            }
        });
    </script>
}
