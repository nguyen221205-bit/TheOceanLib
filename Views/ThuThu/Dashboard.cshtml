@model List<DoAn_LTWeb.Models.DTOs.RecentPhieuMuonDto>

@{
    Layout = "~/Views/Shared/_LayoutThuThu.cshtml";
}

<div class="container-fluid px-0">
    <!-- --- TIÊU ĐỀ DASHBOARD --- -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-primary fw-bold">Dashboard Tổng Quan</h2>
            <p class="text-secondary mb-0">Hệ thống theo dõi và quản lý vận hành thư viện lập trình.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="location.reload();">
                <i class="fa-solid fa-rotate me-1"></i> Tải lại dữ liệu
            </button>
            <button class="btn btn-primary rounded-pill px-3" onclick="showToast('Đồng bộ hệ thống thành công!', 'fa-circle-check');">
                <i class="fa-solid fa-sync me-1"></i> Đồng bộ DB
            </button>
        </div>
    </div>

    <!-- --- 4 THẺ THỐNG KÊ (GLASS CARDS) --- -->
    <div class="row g-3 mb-4">
        <!-- Thẻ 1: Tổng sách -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium d-block mb-1">Tổng Số Đầu Sách</span>
                    <h3 class="mb-1 fw-bold text-primary">@ViewBag.TotalBooks</h3>
                    <small class="text-secondary">@ViewBag.TotalCopies bản cuốn vật lý</small>
                </div>
                <div class="stat-card-icon">
                    <i class="fa-solid fa-book-open"></i>
                </div>
            </div>
        </div>

        <!-- Thẻ 2: Đang mượn -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium d-block mb-1">Sách Đang Cho Mượn</span>
                    <h3 class="mb-1 fw-bold text-success">@ViewBag.BorrowedCopies</h3>
                    @{
                        double borrowRate = Math.Round((double)ViewBag.BorrowedCopies / (double)ViewBag.TotalCopies * 100, 1);
                    }
                    <small class="text-secondary">Chiếm @borrowRate% tổng số sách</small>
                </div>
                <div class="stat-card-icon">
                    <i class="fa-solid fa-book-reader" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                </div>
            </div>
        </div>

        <!-- Thẻ 3: Chờ duyệt -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium d-block mb-1">Yêu Cầu Chờ Duyệt</span>
                    <h3 class="mb-1 fw-bold text-warning">@ViewBag.PendingRequests</h3>
                    <small class="text-secondary">Cần thủ thư xử lý gấp</small>
                </div>
                <div class="stat-card-icon">
                    <i class="fa-solid fa-clock" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                </div>
            </div>
        </div>

        <!-- Thẻ 4: Quá hạn -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="glass-card stat-card p-3 h-100 d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-medium d-block mb-1">Phiếu Quá Hạn</span>
                    <h3 class="mb-1 fw-bold text-danger">@ViewBag.OverdueTickets</h3>
                    <small class="text-secondary">Đã quá ngày hẹn trả sách</small>
                </div>
                <div class="stat-card-icon">
                    <i class="fa-solid fa-triangle-exclamation" style="background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- --- KHU VỰC BIỂU ĐỒ (CHARTS) --- -->
    <div class="row g-4 mb-4">
        <!-- Biểu đồ 1: Thể loại mượn nhiều -->
        <div class="col-12 col-lg-5">
            <div class="glass-card p-4 h-100">
                <h5 class="dashboard-section-title">
                    <i class="fa-solid fa-chart-pie text-primary"></i> Cơ Cấu Mượn Theo Thể Loại
                </h5>
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="genreChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Biểu đồ 2: Xu hướng mượn theo tháng -->
        <div class="col-12 col-lg-7">
            <div class="glass-card p-4 h-100">
                <h5 class="dashboard-section-title">
                    <i class="fa-solid fa-chart-line text-primary"></i> Xu Hướng Mượn Sách Theo Tháng
                </h5>
                <div style="position: relative; height: 280px; width: 100%;">
                    <canvas id="monthlyChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- --- BẢNG YÊU CẦU MƯỢN MỚI NHẤT --- -->
    <div class="glass-card p-4 mb-2">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="dashboard-section-title mb-0">
                <i class="fa-solid fa-list-check text-primary"></i> Phiếu Mượn Gần Đây Cần Xử Lý
            </h5>
            <span class="badge bg-secondary-soft text-secondary rounded-pill px-3 py-1">Cập nhật thời gian thực</span>
        </div>
        
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px; text-align: center;">Mã Phiếu</th>
                        <th style="width: 120px; text-align: center; white-space: nowrap;">Mã Độc Giả</th>
                        <th style="text-align: left;">Độc Giả</th>
                        <th style="width: 140px; text-align: center;">Ngày Mượn</th>
                        <th style="width: 140px; text-align: center;">Hạn Hẹn Trả</th>
                        <th style="width: 140px; text-align: center;">Trạng Thái</th>
                        <th style="width: 120px; text-align: center;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        // Kiểm tra nếu phiếu đã quá hạn dựa trên ngày hẹn trả
                        bool isOverdue = false;
                        DateTime henTraDate;
                        if (DateTime.TryParseExact(item.NgayHenTra, "dd/MM/yyyy", null, System.Globalization.DateTimeStyles.None, out henTraDate))
                        {
                            if (henTraDate < DateTime.Today && item.TrangThai != "DaTra" && item.TrangThai != "Đã trả")
                            {
                                isOverdue = true;
                            }
                        }

                        <tr>
                            <td class="text-center fw-bold text-primary">#@item.MaPhieuMuon</td>
                            <td class="text-center fw-bold">@item.MaDocGia</td>
                            <td class="text-start">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary-soft d-flex align-items-center justify-content-center text-primary" style="width: 32px; height: 32px; font-weight: 600; font-size: 0.85rem;">
                                        @string.Concat(item.TenDocGia.Split(' ').Last().Take(1))
                                    </div>
                                    <span class="fw-semibold">@item.TenDocGia</span>
                                </div>
                            </td>
                            <td class="text-center">@item.NgayMuon</td>
                            <td class="text-center">
                                <span class="@(isOverdue ? "text-danger fw-bold" : "")">@item.NgayHenTra</span>
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "DaTra" || item.TrangThai == "Đã trả")
                                {
                                    <span class="status-badge returned"><i class="fa-solid fa-circle-check me-1"></i>Đã trả</span>
                                }
                                else if (isOverdue)
                                {
                                    <span class="status-badge overdue"><i class="fa-solid fa-triangle-exclamation me-1"></i>Trễ hạn</span>
                                }
                                else
                                {
                                    <span class="status-badge borrowed"><i class="fa-solid fa-book-reader me-1"></i>Đang mượn</span>
                                }
                            </td>
                            <td class="text-center action-buttons-cell">
                                <div class="d-flex gap-2 justify-content-center">
                                    <button class="btn btn-outline-primary btn-sm rounded-circle d-flex align-items-center justify-content-center detail-btn" data-id="@item.MaPhieuMuon" title="Chi tiết" style="width: 32px; height: 32px; padding: 0;">
                                        <i class="fa-solid fa-circle-info"></i>
                                    </button>
                                    
                                    @if (item.TrangThai == "DaTra" || item.TrangThai == "Đã trả")
                                    {
                                        <button class="btn btn-secondary btn-sm rounded-circle d-flex align-items-center justify-content-center remind-btn" data-id="@item.MaPhieuMuon" title="Không thể nhắc nhở (Đã trả)" disabled style="width: 32px; height: 32px; padding: 0; opacity: 0.5;">
                                            <i class="fa-solid fa-bell"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning btn-sm rounded-circle d-flex align-items-center justify-content-center remind-btn" data-id="@item.MaPhieuMuon" title="Nhắc nhở quá hạn" style="width: 32px; height: 32px; padding: 0;">
                                            <i class="fa-solid fa-bell"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- --- MODAL POPUP CHI TIẾT PHIẾU MƯỢN --- -->
<div class="modal fade" id="pmDetailModal" tabindex="-1" aria-labelledby="pmDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content glass-card" style="background-color: var(--bg-surface-glass); backdrop-filter: blur(20px); border: 1px solid var(--border-color); overflow: hidden; border-radius: 20px;">
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title text-primary fw-bold fs-4" id="pmDetailModalLabel">
                    <i class="fa-solid fa-circle-info me-2"></i> Chi Tiết Phiếu Mượn <span id="detailPmId">#0</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width: 120px;">Mã Bản Sách</th>
                                <th>Tên Sách</th>
                                <th style="width: 140px;">Vị Trí Kệ</th>
                                <th style="width: 150px; text-align: center;">Trạng Thái Trả</th>
                            </tr>
                        </thead>
                        <tbody id="detailBooksTableBody">
                            <!-- Render bằng JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
            
            <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Lấy phong cách CSS động để làm đẹp biểu đồ đồng nhất với Theme Sáng/Tối
            const style = getComputedStyle(document.documentElement);
            const primaryColor = style.getPropertyValue('--primary').trim() || '#0077b6';
            const accentColor = style.getPropertyValue('--accent').trim() || '#00b4d8';
            const textPrimaryColor = style.getPropertyValue('--text-primary').trim() || '#0c1e36';
            const borderClr = style.getPropertyValue('--border-color').trim() || '#e0f2fe';

            // Dữ liệu từ ViewBag chuyển qua
            const genreLabels = @Html.Raw(ViewBag.GenreLabels);
            const genreCounts = @Html.Raw(ViewBag.GenreCounts);
            
            const monthLabels = @Html.Raw(ViewBag.MonthLabels);
            const monthCounts = @Html.Raw(ViewBag.MonthCounts);

            // ================= BIỂU ĐỒ THỂ LOẠI (DOUGHNUT) =================
            const ctxGenre = document.getElementById('genreChart').getContext('2d');
            const genreChart = new Chart(ctxGenre, {
                type: 'doughnut',
                data: {
                    labels: genreLabels,
                    datasets: [{
                        data: genreCounts,
                        backgroundColor: [
                            'rgba(0, 119, 182, 0.75)',  // Deep Ocean Blue
                            'rgba(0, 180, 216, 0.75)',  // Cyan/Aqua
                            'rgba(16, 185, 129, 0.75)',  // Emerald Green
                            'rgba(245, 158, 11, 0.75)',  // Amber Orange
                            'rgba(139, 92, 246, 0.75)'   // Purple
                        ],
                        borderColor: borderClr,
                        borderWidth: 2,
                        hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: textPrimaryColor,
                                font: {
                                    family: 'Inter',
                                    size: 11
                                },
                                padding: 15
                            }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return ` Mượn: ${context.raw} lượt`;
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });

            // ================= BIỂU ĐỒ XU HƯỚNG THEO THÁNG (LINE CHART) =================
            const ctxMonthly = document.getElementById('monthlyChart').getContext('2d');
            
            // Tạo Gradient màu Ocean
            const oceanGradient = ctxMonthly.createLinearGradient(0, 0, 0, 250);
            oceanGradient.addColorStop(0, 'rgba(0, 180, 216, 0.35)');
            oceanGradient.addColorStop(1, 'rgba(0, 180, 216, 0.00)');

            const monthlyChart = new Chart(ctxMonthly, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Lượt mượn sách',
                        data: monthCounts,
                        backgroundColor: oceanGradient,
                        borderColor: accentColor,
                        borderWidth: 3,
                        pointBackgroundColor: primaryColor,
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: textPrimaryColor,
                                font: {
                                    family: 'Inter',
                                    size: 11
                                }
                            }
                        },
                        y: {
                            grid: {
                                color: borderClr
                            },
                            ticks: {
                                color: textPrimaryColor,
                                font: {
                                    family: 'Inter',
                                    size: 11
                                },
                                stepSize: 20
                            }
                        }
                    }
                }
            });

            // Đồng bộ lại màu sắc biểu đồ khi người dùng đổi Theme Sáng/Tối
            $('#themeToggleBtn').on('click', function() {
                setTimeout(function() {
                    const nextStyle = getComputedStyle(document.documentElement);
                    const nextTextClr = nextStyle.getPropertyValue('--text-primary').trim();
                    const nextBorderClr = nextStyle.getPropertyValue('--border-color').trim();

                    // Cập nhật biểu đồ thể loại
                    genreChart.options.plugins.legend.labels.color = nextTextClr;
                    genreChart.data.datasets[0].borderColor = nextBorderClr;
                    genreChart.update();

                    // Cập nhật biểu đồ xu hướng tháng
                    monthlyChart.options.scales.x.ticks.color = nextTextClr;
                    monthlyChart.options.scales.y.ticks.color = nextTextClr;
                    monthlyChart.options.scales.y.grid.color = nextBorderClr;
                    monthlyChart.update();
                }, 100);
            });

            // ================= CÁC SỰ KIỆN THAO TÁC =================
            
            // Nút xem chi tiết phiếu mượn
            $(document).on('click', '.detail-btn', function () {
                const id = $(this).data('id');
                $('#detailPmId').text('#' + id);
                
                // Mở Modal
                const detailModal = new bootstrap.Modal(document.getElementById('pmDetailModal'));
                detailModal.show();

                $('#detailBooksTableBody').html('<tr><td colspan="4" class="text-center py-4 text-secondary"><i class="fa-solid fa-spinner fa-spin fs-3 mb-2"></i><p>Đang tải chi tiết...</p></td></tr>');

                $.ajax({
                    url: '/ThuThu/GetPhieuMuonDetail',
                    type: 'GET',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            const tbody = $('#detailBooksTableBody');
                            tbody.empty();

                            response.data.forEach(function (item) {
                                const isReturned = item.NgayTraThucTe !== "";
                                tbody.append(`
                                    <tr>
                                        <td class="fw-bold text-primary">#${item.MaCuonSach}</td>
                                        <td class="fw-semibold">${item.TenSach}</td>
                                        <td><span class="badge bg-secondary-soft text-secondary">${item.ViTriKe}</span></td>
                                        <td class="text-center">
                                            ${isReturned ? 
                                                `<span class="badge bg-success-soft text-success px-2 py-1 rounded-pill small"><i class="fa-solid fa-circle-check me-1"></i>Đã trả (${item.NgayTraThucTe}) - ${item.TinhTrangKhiTra}</span>` : 
                                                '<span class="badge bg-warning-soft text-warning px-2 py-1 rounded-pill small"><i class="fa-solid fa-hourglass-half me-1"></i>Đang mượn</span>'
                                            }
                                        </td>
                                    </tr>
                                `);
                            });
                        } else {
                            showToast(response.message || 'Lỗi tải chi tiết phiếu mượn!', 'fa-solid fa-triangle-exclamation');
                            bootstrap.Modal.getInstance(document.getElementById('pmDetailModal')).hide();
                        }
                    },
                    error: function () {
                        showToast('Không thể kết nối đến máy chủ.', 'fa-solid fa-triangle-exclamation');
                        bootstrap.Modal.getInstance(document.getElementById('pmDetailModal')).hide();
                    }
                });
            });

            // Nút nhắc nhở quá hạn
            $(document).on('click', '.remind-btn', function () {
                const id = $(this).data('id');
                const btn = $(this);
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin"></i>');

                $.ajax({
                    url: '/ThuThu/GuiNhacNhoPhieu',
                    type: 'POST',
                    data: { id: id },
                    success: function (response) {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-bell"></i>');
                        if (response.success) {
                            showToast(response.message || 'Đã gửi nhắc nhở quá hạn thành công!', 'fa-solid fa-paper-plane');
                        } else {
                            showToast('Có lỗi xảy ra khi gửi nhắc nhở!', 'fa-solid fa-triangle-exclamation');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="fa-solid fa-bell"></i>');
                        showToast('Không thể kết nối đến máy chủ.', 'fa-solid fa-triangle-exclamation');
                    }
                });
            });
        });
    </script>
}
