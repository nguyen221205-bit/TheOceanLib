@model List<DoAn_LTWeb.Models.DTOs.YeuCauMuonDto>

@{
    Layout = "~/Views/Shared/_LayoutThuThu.cshtml";
}

<div class="container-fluid px-0">
    <!-- --- TIÊU ĐỀ TRANG --- -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-primary fw-bold">Yêu Cầu Mượn Sách Trực Tuyến</h2>
            <p class="text-secondary mb-0">Xem, phê duyệt giữ sách 48h và xác nhận trao sách tại quầy cho độc giả.</p>
        </div>
        <div>
            <button class="btn btn-outline-secondary rounded-pill px-3" onclick="location.reload();">
                <i class="fa-solid fa-rotate me-1"></i> Tải lại danh sách
            </button>
        </div>
    </div>

    <!-- --- BẢNG DANH SÁCH YÊU CẦU MƯỢN --- -->
    <div class="glass-card p-4">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0" id="requestsTable">
                <thead>
                    <tr>
                        <th style="width: 100px; text-align: center;">Mã Đơn</th>
                        <th style="width: 120px; text-align: center; white-space: nowrap;">Mã Độc Giả</th>
                        <th style="text-align: left;">Tên Độc Giả</th>
                        <th style="width: 180px; text-align: center;">Ngày Gửi Yêu Cầu</th>
                        <th style="width: 130px; text-align: center;">Số Lượng</th>
                        <th style="width: 180px; text-align: center;">Trạng Thái</th>
                        <th style="width: 160px; text-align: center;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-secondary">
                                <i class="fa-solid fa-folder-open fs-1 mb-3 text-muted" style="opacity: 0.4;"></i>
                                <p class="mb-0 fw-semibold">Không có yêu cầu mượn nào cần xử lý!</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaYeuCau">
                                <td class="text-center fw-bold text-primary">#YC@(item.MaYeuCau)</td>
                                <td class="text-center fw-bold">#DG@(item.MaDocGia)</td>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-soft d-flex align-items-center justify-content-center text-primary fw-semibold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                            @string.Concat(item.TenDocGia.Split(' ').Last().Take(1))
                                        </div>
                                        <span class="fw-semibold">@item.TenDocGia</span>
                                    </div>
                                </td>
                                <td class="text-center">@item.NgayGui</td>
                                <td class="text-center">
                                    <span class="badge bg-primary-soft text-primary px-3 py-1 rounded-pill fw-bold">@item.SoLuongSach cuốn</span>
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <span class="status-badge pending">
                                            <i class="fa-solid fa-hourglass-half me-1"></i>Chờ duyệt
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã duyệt")
                                    {
                                        <span class="status-badge active" style="background: rgba(16, 185, 129, 0.15); color: #10b981;">
                                            <i class="fa-solid fa-bookmark me-1"></i>Đã duyệt (Giữ 48h)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <button class="btn btn-primary btn-sm rounded-pill px-3 handle-req-btn" data-id="@item.MaYeuCau">
                                            <i class="fa-solid fa-gears me-1"></i> Phê duyệt
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-success btn-sm rounded-pill px-3 handle-req-btn" data-id="@item.MaYeuCau">
                                            <i class="fa-solid fa-hand-holding-hand me-1"></i> Trao sách
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- --- MODAL POPUP CHI TIẾT & XỬ LÝ (GLASSMORPHISM) --- -->
<div class="modal fade" id="ycDetailModal" tabindex="-1" aria-labelledby="ycDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content glass-card" style="background-color: var(--bg-surface-glass); backdrop-filter: blur(20px); border: 1px solid var(--border-color); overflow: hidden; border-radius: 20px;">
            <!-- Header Modal -->
            <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                <h5 class="modal-title text-primary fw-bold fs-4" id="ycDetailModalLabel">
                    <i class="fa-solid fa-circle-info me-2"></i> Chi Tiết Yêu Cầu Mượn <span id="modalReqId">#0</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <!-- Body Modal -->
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Cột Trái: Thông tin độc giả & Trạng thái -->
                    <div class="col-12 col-lg-5 border-end-lg" style="border-color: var(--border-color) !important;">
                        <div class="p-3 rounded-4" style="background-color: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                            <h6 class="text-primary fw-bold mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                                <i class="fa-regular fa-user me-2"></i> Thông Tin Độc Giả
                            </h6>
                            
                            <table class="table table-borderless table-sm mb-4 small text-secondary">
                                <tr>
                                    <td style="width: 130px;" class="fw-semibold">Mã độc giả:</td>
                                    <td id="infoMaDocGia" class="fw-bold text-primary">#DG000</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Họ và tên:</td>
                                    <td id="infoHoTen" class="fw-bold text-primary-light">Họ và Tên</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Số điện thoại:</td>
                                    <td id="infoSdt">090000000</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Email:</td>
                                    <td id="infoEmail">email@example.com</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Địa chỉ:</td>
                                    <td id="infoDiaChi">Địa chỉ cư trú</td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Thời điểm gửi:</td>
                                    <td id="infoNgayGui" class="fw-bold text-info">--/--/----</td>
                                </tr>
                                <tr id="rowHanDenNhan">
                                    <td class="fw-semibold text-warning">Hạn lấy sách (48h):</td>
                                    <td id="infoHanDenNhan" class="fw-bold text-warning">--/--/----</td>
                                </tr>
                            </table>

                            <div class="p-3 rounded-3 mb-2" style="background: rgba(14, 165, 233, 0.08); border: 1px solid rgba(14, 165, 233, 0.2);">
                                <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-sliders me-1"></i> Thiết Lập Phiếu Mượn Tại Quầy</h6>
                                <div class="mb-2">
                                    <label for="modalSoNgayMuon" class="form-label small fw-semibold text-secondary mb-1">Số ngày mượn chính thức</label>
                                    <select id="modalSoNgayMuon" class="form-select form-select-sm bg-transparent" style="border-color: var(--border-color); color: var(--text-primary);">
                                        <option value="7" style="background: #0f172a; color: #ffffff;">7 ngày (1 tuần)</option>
                                        <option value="14" selected style="background: #0f172a; color: #ffffff;">14 ngày (2 tuần - Mặc định)</option>
                                        <option value="21" style="background: #0f172a; color: #ffffff;">21 ngày (3 tuần)</option>
                                        <option value="30" style="background: #0f172a; color: #ffffff;">30 ngày (1 tháng)</option>
                                    </select>
                                </div>
                                <p class="extra-small text-secondary mb-0">
                                    <i class="fa-solid fa-circle-info me-1"></i>Ngày mượn tự động lấy từ HÔM NAY. Hạn trả = Ngày mượn + Số ngày trên.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Cột Phải: Danh sách sách đăng ký mượn & Gợi ý kệ sách -->
                    <div class="col-12 col-lg-7">
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2" style="border-color: var(--border-color) !important;">
                            <i class="fa-solid fa-book me-2"></i> Sách Độc Giả Đăng Ký Mượn
                        </h6>
                        
                        <!-- Danh sách sách cuộn dài -->
                        <div id="modalBooksList" class="d-flex flex-column gap-3" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
                            <!-- Sẽ render động qua Javascript -->
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Footer Modal -->
            <div class="modal-footer border-top-0 px-4 pb-4 pt-0 justify-content-between">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-danger rounded-pill px-4" id="modalRejectBtn">
                        <i class="fa-solid fa-xmark me-1"></i> Từ Chối Yêu Cầu
                    </button>
                    <!-- Nút Duyệt & Giữ sách 48h (Dành cho đơn Chờ duyệt) -->
                    <button type="button" class="btn btn-primary rounded-pill px-4 bg-gradient" id="modalApproveBtn">
                        <i class="fa-solid fa-bookmark me-1"></i> Duyệt & Giữ Sách (48h)
                    </button>
                    <!-- Nút Xác nhận Trao sách Tại Quầy (Dành cho đơn Đã duyệt) -->
                    <button type="button" class="btn btn-success rounded-pill px-4 bg-gradient d-none" id="modalHandoverBtn">
                        <i class="fa-solid fa-hand-holding-hand me-1"></i> Xác Nhận Trao Sách
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            let currentReqId = 0;
            let hasOutOfStockBook = false;
            let currentStatus = '';

            // 1. SỰ KIỆN NHẤN XỬ LÝ / TRAO SÁCH
            $('.handle-req-btn').on('click', function () {
                const id = $(this).data('id');
                currentReqId = id;
                hasOutOfStockBook = false;

                // Reset modal UI
                $('#modalReqId').text('#YC' + id);
                $('#modalBooksList').html('<div class="text-center py-5 text-secondary"><i class="fa-solid fa-spinner fa-spin fs-1 mb-2"></i><p>Đang tải dữ liệu...</p></div>');
                $('#modalApproveBtn').prop('disabled', false).removeClass('d-none');
                $('#modalHandoverBtn').addClass('d-none');

                // Mở Modal Popup
                const myModal = new bootstrap.Modal(document.getElementById('ycDetailModal'));
                myModal.show();

                // Gọi Ajax lấy chi tiết yêu cầu mượn
                $.ajax({
                    url: '/ThuThu/GetYeuCauMuonDetail',
                    type: 'GET',
                    data: { id: id },
                    success: function (response) {
                        if (response.success) {
                            const data = response.data;
                            currentStatus = data.TrangThai;

                            // Điền thông tin độc giả
                            $('#infoMaDocGia').text('#DG' + data.MaDocGia);
                            $('#infoHoTen').text(data.TenDocGia);
                            $('#infoSdt').text(data.SoDienThoai);
                            $('#infoEmail').text(data.Email);
                            $('#infoDiaChi').text(data.DiaChi);
                            $('#infoNgayGui').text(data.NgayGui);
                            $('#infoHanDenNhan').text(data.HanDenNhan);

                            if (currentStatus === 'Đã duyệt') {
                                $('#modalApproveBtn').addClass('d-none');
                                $('#modalHandoverBtn').removeClass('d-none');
                                $('#rowHanDenNhan').removeClass('d-none');
                            } else {
                                $('#modalApproveBtn').removeClass('d-none');
                                $('#modalHandoverBtn').addClass('d-none');
                                $('#rowHanDenNhan').addClass('d-none');
                            }

                            // Render danh sách sách mượn
                            const booksContainer = $('#modalBooksList');
                            booksContainer.empty();

                            data.DanhSachSach.forEach(function (book) {
                                const isAvailable = book.SoLuongCoSan >= book.SoLuongMuon;
                                if (!isAvailable && currentStatus === 'Chờ duyệt') {
                                    hasOutOfStockBook = true;
                                }

                                let suggestText = '';
                                if (isAvailable && book.BanSachGoiY && book.BanSachGoiY.length > 0) {
                                    suggestText = '<div class="mt-2 p-2 rounded-3 small" style="background-color: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.15);">';
                                    suggestText += '<strong class="text-success d-block mb-1"><i class="fa-solid fa-tag me-1"></i> Bản sách vật lý gợi ý trên kệ:</strong>';
                                    book.BanSachGoiY.forEach(function (copy) {
                                        suggestText += `<span class="badge bg-secondary-soft text-secondary me-2">Mã bản: #${copy.MaCuonSach} (Kệ: ${copy.ViTriKe})</span>`;
                                    });
                                    suggestText += '</div>';
                                } else {
                                    suggestText = '<div class="mt-2 p-2 rounded-3 small" style="background-color: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.15);">';
                                    suggestText += '<strong class="text-danger"><i class="fa-solid fa-triangle-exclamation me-1"></i> Không đủ cuốn sách vật lý có sẵn!</strong>';
                                    suggestText += '</div>';
                                }

                                const imgUrl = book.AnhBia ? (book.AnhBia.startsWith('http') ? book.AnhBia : '/Content/HinhAnh/' + book.AnhBia) : 'https://placehold.co/120x160/0f172a/ffffff?text=Book';

                                booksContainer.append(`
                                    <div class="glass-card p-3 d-flex align-items-center gap-3 w-100" style="transition: none; transform: none; box-shadow: none;">
                                        <img src="${imgUrl}" class="rounded-2" alt="${book.TenSach}" style="width: 60px; height: 80px; object-fit: cover;" onerror="this.src='https://placehold.co/120x160/0f172a/ffffff?text=Book'">
                                        <div class="flex-grow-1 min-w-0">
                                            <h6 class="fw-bold mb-1 text-truncate" title="${book.TenSach}">${book.TenSach}</h6>
                                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                                <span class="small text-secondary fw-semibold">
                                                    Đăng ký: <span class="badge bg-primary text-white rounded-pill px-2 fs-7">${book.SoLuongMuon} cuốn</span>
                                                </span>
                                                <span class="small text-secondary">|</span>
                                                <span class="small text-secondary">
                                                    Khả dụng: <strong class="text-primary-light">${book.SoLuongCoSan} bản</strong>
                                                </span>
                                            </div>
                                            ${suggestText}
                                        </div>
                                    </div>
                                `);
                            });

                            if (hasOutOfStockBook && currentStatus === 'Chờ duyệt') {
                                $('#modalApproveBtn').prop('disabled', true).attr('title', 'Không thể duyệt do kho không đủ sách vật lý');
                            }
                        } else {
                            showToast(response.message || 'Lỗi tải chi tiết yêu cầu mượn!', 'fa-solid fa-circle-exclamation');
                            bootstrap.Modal.getInstance(document.getElementById('ycDetailModal')).hide();
                        }
                    },
                    error: function () {
                        showToast('Không thể kết nối đến máy chủ để lấy chi tiết.', 'fa-solid fa-triangle-exclamation');
                        bootstrap.Modal.getInstance(document.getElementById('ycDetailModal')).hide();
                    }
                });
            });

            // 2. BƯỚC 1: DUYỆT & GIỮ SÁCH (48H)
            $('#modalApproveBtn').on('click', function () {
                if (hasOutOfStockBook) {
                    showToast('Kho không đủ bản sách vật lý khả dụng!', 'fa-solid fa-triangle-exclamation');
                    return;
                }

                $(this).prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang duyệt...');

                $.ajax({
                    url: '/ThuThu/DuyetYeuCau',
                    type: 'POST',
                    data: { id: currentReqId },
                    success: function (response) {
                        $('#modalApproveBtn').prop('disabled', false).html('<i class="fa-solid fa-bookmark me-1"></i> Duyệt & Giữ Sách (48h)');
                        
                        if (response.success) {
                            showToast(response.message || 'Đã duyệt yêu cầu & giữ sách thành công!', 'fa-solid fa-circle-check');
                            bootstrap.Modal.getInstance(document.getElementById('ycDetailModal')).hide();
                            location.reload();
                        } else {
                            showToast(response.message || 'Có lỗi xảy ra khi duyệt mượn!', 'fa-solid fa-triangle-exclamation');
                        }
                    },
                    error: function () {
                        $('#modalApproveBtn').prop('disabled', false).html('<i class="fa-solid fa-bookmark me-1"></i> Duyệt & Giữ Sách (48h)');
                        showToast('Lỗi kết nối máy chủ.', 'fa-solid fa-triangle-exclamation');
                    }
                });
            });

            // 3. BƯỚC 2: XÁC NHẬN TRAO SÁCH TẠI QUẦY (TẠO PHIẾU MƯỢN)
            $('#modalHandoverBtn').on('click', function () {
                const selectedDays = $('#modalSoNgayMuon').val() || 14;
                $(this).prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang trao sách...');

                $.ajax({
                    url: '/ThuThu/XacNhanTraoSach',
                    type: 'POST',
                    data: { id: currentReqId, soNgayMuon: selectedDays },
                    success: function (response) {
                        $('#modalHandoverBtn').prop('disabled', false).html('<i class="fa-solid fa-hand-holding-hand me-1"></i> Xác Nhận Trao Sách');
                        
                        if (response.success) {
                            showToast(response.message || 'Đã xác nhận trao sách thành công!', 'fa-solid fa-circle-check');
                            bootstrap.Modal.getInstance(document.getElementById('ycDetailModal')).hide();
                            
                            $(`#row-${currentReqId}`).fadeOut(500, function () {
                                $(this).remove();
                                if ($('#requestsTable tbody tr').length === 0) {
                                    location.reload();
                                }
                            });
                        } else {
                            showToast(response.message || 'Có lỗi xảy ra khi trao sách!', 'fa-solid fa-triangle-exclamation');
                        }
                    },
                    error: function () {
                        $('#modalHandoverBtn').prop('disabled', false).html('<i class="fa-solid fa-hand-holding-hand me-1"></i> Xác Nhận Trao Sách');
                        showToast('Lỗi kết nối máy chủ.', 'fa-solid fa-triangle-exclamation');
                    }
                });
            });

            // 4. SỰ KIỆN TỪ CHỐI YÊU CẦU
            $('#modalRejectBtn').on('click', function () {
                if (confirm(`Bạn chắc chắn muốn từ chối yêu cầu mượn #${currentReqId}?`)) {
                    $(this).prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Đang từ chối...');

                    $.ajax({
                        url: '/ThuThu/TuChoiYeuCau',
                        type: 'POST',
                        data: { id: currentReqId },
                        success: function (response) {
                            $('#modalRejectBtn').prop('disabled', false).html('<i class="fa-solid fa-xmark me-1"></i> Từ Chối Yêu Cầu');
                            
                            if (response.success) {
                                showToast(response.message || 'Đã từ chối yêu cầu mượn thành công!', 'fa-solid fa-circle-xmark');
                                bootstrap.Modal.getInstance(document.getElementById('ycDetailModal')).hide();
                                
                                $(`#row-${currentReqId}`).fadeOut(500, function () {
                                    $(this).remove();
                                    if ($('#requestsTable tbody tr').length === 0) {
                                        location.reload();
                                    }
                                });
                            } else {
                                showToast(response.message || 'Có lỗi xảy ra khi từ chối yêu cầu!', 'fa-solid fa-triangle-exclamation');
                            }
                        },
                        error: function () {
                            $('#modalRejectBtn').prop('disabled', false).html('<i class="fa-solid fa-xmark me-1"></i> Từ Chối Yêu Cầu');
                            showToast('Không thể kết nối đến máy chủ.', 'fa-solid fa-triangle-exclamation');
                        }
                    });
                }
            });
        });
    </script>
}
