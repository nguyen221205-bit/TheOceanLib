@using DoAn_LTWeb.Models
@model List<TheLoai>

<div class="dropdown">
    <button class="category-dropdown-btn dropdown-toggle" type="button" id="categoryMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
        <i class="fa-solid fa-bars"></i> Menu danh mục
    </button>
    <ul class="dropdown-menu account-dropdown-menu" aria-labelledby="categoryMenuButton">
        @foreach (var item in Model)
        {
            <li>
                <a class="dropdown-item" href="@Url.Action("HienThiDSSP", "Home", new { maTheLoai = item.MaTheLoai })">
                    <i class="fa-solid fa-tag text-primary me-2"></i> @item.TenTheLoai
                </a>
            </li>
        }
    </ul>
</div>
