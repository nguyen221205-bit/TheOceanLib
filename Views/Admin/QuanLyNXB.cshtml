@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Nhà xuất bản";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-building-columns text-success me-2"></i>Quản Lý Nhà Xuất Bản
            </h3>
            <p class="text-muted small mb-0">Quản lý danh sách nhà xuất bản đối tác.</p>
        </div>
        <button class="btn btn-success rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-plus me-1"></i>Thêm NXB Mới
        </button>
    </div>

    <div class="glass-card p-4 rounded-4 border text-center py-5">
        <i class="fa-solid fa-building fs-1 text-success mb-3"></i>
        <h4 class="fw-bold" style="color: var(--text-primary);">Giao Diện Xem Trước: Quản Lý Nhà Xuất Bản</h4>
        <p class="text-muted">Quản lý thông tin địa chỉ, hotline và danh sách Nhà xuất bản.</p>
    </div>
</div>
