@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Tác giả";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-feather-pointed text-warning me-2"></i>Quản Lý Tác Giả
            </h3>
            <p class="text-muted small mb-0">Quản lý hồ sơ tác giả viết sách trong hệ thống.</p>
        </div>
        <button class="btn btn-warning text-dark rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-plus me-1"></i>Thêm Tác Giả Mới
        </button>
    </div>

    <div class="glass-card p-4 rounded-4 border text-center py-5">
        <i class="fa-solid fa-user-pen fs-1 text-warning mb-3"></i>
        <h4 class="fw-bold" style="color: var(--text-primary);">Giao Diện Xem Trước: Quản Lý Tác Giả</h4>
        <p class="text-muted">Quản lý danh sách tác giả, thông tin tiểu sử và liên kết tác phẩm.</p>
    </div>
</div>
