@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Tài khoản & Phân quyền";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-users-viewfinder text-danger me-2"></i>Quản Lý Tài Khoản & Phân Quyền
            </h3>
            <p class="text-muted small mb-0">Quản lý danh sách tài khoản độc giả, nhân viên thủ thư và phân quyền vai trò.</p>
        </div>
        <button class="btn btn-danger rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-user-plus me-1"></i>Tạo Tài Khoản Thủ Thư
        </button>
    </div>

    <div class="glass-card p-4 rounded-4 border text-center py-5">
        <i class="fa-solid fa-user-gear fs-1 text-danger mb-3"></i>
        <h4 class="fw-bold" style="color: var(--text-primary);">Giao Diện Xem Trước: Quản Lý Tài Khoản</h4>
        <p class="text-muted">Danh sách tài khoản toàn bộ người dùng. Hỗ trợ nâng/hạ quyền (Độc giả ↔ Thủ thư), Khóa / Mở khóa tài khoản.</p>
    </div>
</div>
