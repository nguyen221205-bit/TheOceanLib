@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý & Chạy thử Web API (RESTful API Console)";
}

<div class="container-fluid px-0">
    <!-- --- TIÊU ĐỀ TRANG --- -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1 text-primary fw-bold">
                <i class="fa-solid fa-plug text-warning me-2"></i>RESTful Web API Console & Tester
            </h2>
            <p class="text-secondary mb-0">Hệ thống API RESTful Quản lý Sách công khai dành cho Lập trình viên & Kiểm thử báo cáo Đồ án.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-success-soft text-success px-3 py-2 rounded-pill fs-7 fw-bold border border-success">
                <i class="fa-solid fa-signal me-1"></i> API Service: ONLINE
            </span>
            <span class="badge bg-primary-soft text-primary px-3 py-2 rounded-pill fs-7 fw-bold border border-primary">
                <i class="fa-solid fa-code me-1"></i> Output: JSON Format
            </span>
        </div>
    </div>

    <!-- --- CARD TỔNG QUAN ENDPOINTS --- -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-3">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <span class="badge bg-success px-3 py-2 rounded-3 fs-6 font-monospace fw-bold">GET</span>
                <div>
                    <div class="fw-bold">Lấy danh sách sách</div>
                    <div class="small text-secondary font-monospace">/api/SachApi</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <span class="badge bg-info px-3 py-2 rounded-3 fs-6 font-monospace fw-bold text-dark">GET</span>
                <div>
                    <div class="fw-bold">Xem chi tiết 1 sách</div>
                    <div class="small text-secondary font-monospace">/api/SachApi/GetById/{id}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <span class="badge bg-primary px-3 py-2 rounded-3 fs-6 font-monospace fw-bold">POST</span>
                <div>
                    <div class="fw-bold">Thêm mới cuốn sách</div>
                    <div class="small text-secondary font-monospace">/api/SachApi/Create</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-3">
            <div class="glass-card p-3 d-flex align-items-center gap-3">
                <span class="badge bg-danger px-3 py-2 rounded-3 fs-6 font-monospace fw-bold">DELETE</span>
                <div>
                    <div class="fw-bold">Xóa cuốn sách theo ID</div>
                    <div class="small text-secondary font-monospace">/api/SachApi/Delete/{id}</div>
                </div>
            </div>
        </div>
    </div>

    <!-- --- KHU VỰC INTERACTIVE TESTER & RESULT --- -->
    <div class="row g-4">
        <!-- Cột Trái: Bảng Điều Khiển Gửi Request API -->
        <div class="col-12 col-lg-6">
            <div class="glass-card p-4 h-100">
                <h5 class="fw-bold text-primary mb-3 pb-2 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--border-color) !important;">
                    <span><i class="fa-solid fa-paper-plane me-2"></i>Bảng Điều Khiển Gửi Request</span>
                    <span class="badge bg-secondary font-monospace" style="font-size: 0.75rem;">HTTP Client</span>
                </h5>

                <!-- Chọn Endpoint API -->
                <div class="mb-3">
                    <label for="apiEndpointSelect" class="form-label fw-semibold text-secondary">Chọn Thao Tác API (CRUD Operation)</label>
                    <select id="apiEndpointSelect" class="form-select bg-transparent" style="border-color: var(--border-color); color: var(--text-primary);">
                        <option value="GET_LIST" style="background: var(--bg-surface); color: var(--text-primary);">🟢 [GET] /api/SachApi - Lấy danh sách sách (Read All)</option>
                        <option value="GET_BY_ID" style="background: var(--bg-surface); color: var(--text-primary);">🔵 [GET] /api/SachApi/GetById/{id} - Lấy chi tiết sách theo ID (Read One)</option>
                        <option value="POST_CREATE" style="background: var(--bg-surface); color: var(--text-primary);">🟢 [POST] /api/SachApi/Create - Thêm mới sách (Create)</option>
                        <option value="PUT_UPDATE" style="background: var(--bg-surface); color: var(--text-primary);">🟡 [POST/PUT] /api/SachApi/Update/{id} - Cập nhật thông tin sách (Update)</option>
                        <option value="DELETE" style="background: var(--bg-surface); color: var(--text-primary);">🔴 [POST/DELETE] /api/SachApi/Delete/{id} - Xóa sách theo ID (Delete)</option>
                    </select>
                </div>

                <!-- FORM INPUT ĐỘNG THEO ENDPOINT -->
                <div id="apiFormContainer" class="p-3 rounded-4 mb-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color);">
                    <!-- 1. Form GET LIST -->
                    <div id="form-GET_LIST" class="api-form-group">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Từ khóa tìm kiếm (search)</label>
                            <input type="text" id="inputSearchList" class="form-control form-control-sm bg-transparent" placeholder="Ví dụ: Lập trình, Clean Code..." style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label class="form-label small fw-semibold text-secondary">Trang (page)</label>
                                <input type="number" id="inputPageList" class="form-control form-control-sm bg-transparent" value="1" min="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-semibold text-secondary">Số lượng/Trang (pageSize)</label>
                                <input type="number" id="inputPageSizeList" class="form-control form-control-sm bg-transparent" value="10" min="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                        </div>
                    </div>

                    <!-- 2. Form GET BY ID -->
                    <div id="form-GET_BY_ID" class="api-form-group d-none">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Mã Sách (ID) <span class="text-danger">*</span></label>
                            <input type="number" id="inputIdGet" class="form-control form-control-sm bg-transparent" value="1" placeholder="Nhập ID sách..." style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                    </div>

                    <!-- 3. Form POST CREATE -->
                    <div id="form-POST_CREATE" class="api-form-group d-none">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Tên Sách <span class="text-danger">*</span></label>
                            <input type="text" id="inputCreateTenSach" class="form-control form-control-sm bg-transparent" value="Lập Trình Web RESTful API C# Expert" style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã Thể Loại</label>
                                <input type="number" id="inputCreateMaTheLoai" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã Tác Giả</label>
                                <input type="number" id="inputCreateMaTacGia" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã NXB</label>
                                <input type="number" id="inputCreateMaNXB" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Năm Xuất Bản</label>
                            <input type="number" id="inputCreateNamXB" class="form-control form-control-sm bg-transparent" value="2026" style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Mô Tả Sách</label>
                            <textarea id="inputCreateMoTa" class="form-control form-control-sm bg-transparent" rows="2" style="border-color: var(--border-color); color: var(--text-primary);">Sách hướng dẫn xây dựng Web API chuẩn RESTful kiến trúc chuyên nghiệp.</textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Tên file Ảnh bìa</label>
                            <input type="text" id="inputCreateAnhBia" class="form-control form-control-sm bg-transparent" value="designpatterns.jpg" style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                    </div>

                    <!-- 4. Form PUT UPDATE -->
                    <div id="form-PUT_UPDATE" class="api-form-group d-none">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Mã Sách Cần Sửa (ID) <span class="text-danger">*</span></label>
                            <input type="number" id="inputUpdateId" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold text-secondary">Tên Sách Mới</label>
                            <input type="text" id="inputUpdateTenSach" class="form-control form-control-sm bg-transparent" value="Clean Code & REST API Best Practices (Updated)" style="border-color: var(--border-color); color: var(--text-primary);" />
                        </div>
                        <div class="row g-2 mb-2">
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã Thể Loại</label>
                                <input type="number" id="inputUpdateMaTheLoai" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã Tác Giả</label>
                                <input type="number" id="inputUpdateMaTacGia" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-secondary">Mã NXB</label>
                                <input type="number" id="inputUpdateMaNXB" class="form-control form-control-sm bg-transparent" value="1" style="border-color: var(--border-color); color: var(--text-primary);" />
                            </div>
                        </div>
                    </div>

                    <!-- 5. Form DELETE -->
                    <div id="form-DELETE" class="api-form-group d-none">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-secondary">Mã Sách Cần Xóa (ID) <span class="text-danger">*</span></label>
                            <input type="number" id="inputDeleteId" class="form-control form-control-sm bg-transparent" value="999" placeholder="Nhập ID sách cần xóa..." style="border-color: var(--border-color); color: var(--text-primary);" />
                            <div class="form-text extra-small text-warning"><i class="fa-solid fa-triangle-exclamation me-1"></i>Lưu ý: Không thể xóa sách nếu đang có bản sách vật lý liên quan trong kho.</div>
                        </div>
                    </div>
                </div>

                <!-- Nút Thực Thi API -->
                <div class="d-flex justify-content-between align-items-center">
                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 bg-gradient font-monospace shadow-sm" id="btnExecuteApi">
                        <i class="fa-solid fa-play me-2"></i>CHẠY THỬ API (EXECUTE REQUEST)
                    </button>
                </div>
            </div>
        </div>

        <!-- Cột Phải: Kết Quả Trả Về & Code Snippet -->
        <div class="col-12 col-lg-6">
            <div class="glass-card p-4 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--border-color) !important;">
                    <h5 class="fw-bold text-primary mb-0"><i class="fa-solid fa-terminal me-2"></i>Kết Quả Response (Real-time)</h5>
                    <div id="statusBadgeContainer">
                        <span class="badge bg-secondary font-monospace px-3 py-1.5" id="resStatusBadge">Status: Ready</span>
                        <span class="badge bg-dark font-monospace text-info px-2 py-1.5 ms-1" id="resTimeBadge">0 ms</span>
                    </div>
                </div>

                <!-- URL & HTTP Method Header -->
                <div class="p-2 rounded-3 mb-3 font-monospace small d-flex align-items-center gap-2" style="background: rgba(0, 0, 0, 0.4); border: 1px solid var(--border-color);">
                    <span class="badge bg-primary" id="resMethodBadge">GET</span>
                    <span class="text-truncate text-info flex-grow-1" id="resUrlText">/api/SachApi</span>
                </div>

                <!-- Màn Hình Terminal JSON Pretty Print -->
                <div class="position-relative flex-grow-1 mb-3">
                    <button class="btn btn-sm btn-outline-secondary position-absolute top-0 end-0 m-2 rounded-pill px-3" id="btnCopyJson" title="Sao chép JSON">
                        <i class="fa-regular fa-copy me-1"></i> Copy JSON
                    </button>
                    <pre class="rounded-4 p-3 font-monospace h-100 mb-0" id="jsonOutputConsole" style="background: #060b16; border: 1px solid var(--border-color); color: #38bdf8; max-height: 380px; overflow-y: auto; font-size: 0.85rem;">
{
    "message": "Sẵn sàng chạy thử API. Hãy chọn thao tác và bấm nút 'CHẠY THỬ API' ở bên trái!"
}
                    </pre>
                </div>

                <!-- Code Snippet Generator -->
                <div class="p-3 rounded-4" style="background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color);">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-secondary"><i class="fa-solid fa-code me-1"></i>Mẫu Code Gọi API (Code Snippet)</span>
                        <select id="snippetLanguageSelect" class="form-select form-select-sm bg-transparent w-auto" style="border-color: var(--border-color); color: var(--text-primary);">
                            <option value="FETCH" style="background: var(--bg-surface); color: var(--text-primary);">JavaScript (fetch)</option>
                            <option value="CURL" style="background: var(--bg-surface); color: var(--text-primary);">cURL Command</option>
                            <option value="CSHARP" style="background: var(--bg-surface); color: var(--text-primary);">C# (HttpClient)</option>
                        </select>
                    </div>
                    <pre class="rounded-3 p-2 font-monospace small mb-0 text-secondary" id="snippetCodeBox" style="background: #0b1528; border: 1px solid var(--border-color); max-height: 120px; overflow: auto; font-size: 0.78rem;">fetch('/api/SachApi').then(res => res.json()).then(data => console.log(data));</pre>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Chuyển đổi Form Input theo Endpoint được chọn
            $('#apiEndpointSelect').on('change', function () {
                const val = $(this).val();
                $('.api-form-group').addClass('d-none');
                $(`#form-${val}`).removeClass('d-none');
                updateSnippet();
            });

            $('#snippetLanguageSelect').on('change', function () {
                updateSnippet();
            });

            // SỰ KIỆN NÚT BẤM CHẠY THỬ API
            $('#btnExecuteApi').on('click', function () {
                const op = $('#apiEndpointSelect').val();
                let url = '';
                let method = 'GET';
                let reqData = null;

                const startTime = performance.now();

                $('#resStatusBadge').attr('class', 'badge bg-warning text-dark font-monospace px-3 py-1.5').text('Executing...');
                $('#jsonOutputConsole').text('// Đang gửi dữ liệu đến máy chủ máy chủ...');

                if (op === 'GET_LIST') {
                    method = 'GET';
                    const q = $('#inputSearchList').val();
                    const page = $('#inputPageList').val() || 1;
                    const pageSize = $('#inputPageSizeList').val() || 10;
                    url = `/api/SachApi?search=${encodeURIComponent(q)}&page=${page}&pageSize=${pageSize}`;
                } 
                else if (op === 'GET_BY_ID') {
                    method = 'GET';
                    const id = $('#inputIdGet').val() || 1;
                    url = `/api/SachApi/GetById/${id}`;
                }
                else if (op === 'POST_CREATE') {
                    method = 'POST';
                    url = `/api/SachApi/Create`;
                    reqData = {
                        TenSach: $('#inputCreateTenSach').val(),
                        MaTheLoai: parseInt($('#inputCreateMaTheLoai').val()) || 1,
                        MaTacGia: parseInt($('#inputCreateMaTacGia').val()) || 1,
                        MaNXB: parseInt($('#inputCreateMaNXB').val()) || 1,
                        NamXuatBan: parseInt($('#inputCreateNamXB').val()) || 2026,
                        MoTa: $('#inputCreateMoTa').val(),
                        AnhBia: $('#inputCreateAnhBia').val()
                    };
                }
                else if (op === 'PUT_UPDATE') {
                    method = 'POST';
                    const id = $('#inputUpdateId').val() || 1;
                    url = `/api/SachApi/Update/${id}`;
                    reqData = {
                        TenSach: $('#inputUpdateTenSach').val(),
                        MaTheLoai: parseInt($('#inputUpdateMaTheLoai').val()) || 1,
                        MaTacGia: parseInt($('#inputUpdateMaTacGia').val()) || 1,
                        MaNXB: parseInt($('#inputUpdateMaNXB').val()) || 1
                    };
                }
                else if (op === 'DELETE') {
                    method = 'POST';
                    const id = $('#inputDeleteId').val() || 999;
                    url = `/api/SachApi/Delete/${id}`;
                }

                $('#resMethodBadge').text(method);
                $('#resUrlText').text(url);

                $.ajax({
                    url: url,
                    type: method,
                    data: reqData,
                    success: function (res, textStatus, xhr) {
                        const endTime = performance.now();
                        const duration = Math.round(endTime - startTime);

                        const statusCode = res.statusCode || xhr.status || 200;
                        const statusText = res.status || 'OK';

                        $('#resTimeBadge').text(`${duration} ms`);

                        if (statusCode >= 200 && statusCode < 300) {
                            $('#resStatusBadge').attr('class', 'badge bg-success font-monospace px-3 py-1.5').text(`HTTP ${statusCode} ${statusText}`);
                        } else {
                            $('#resStatusBadge').attr('class', 'badge bg-danger font-monospace px-3 py-1.5').text(`HTTP ${statusCode} ${statusText}`);
                        }

                        // Formatted JSON Output
                        $('#jsonOutputConsole').text(JSON.stringify(res, null, 4));
                        updateSnippet();
                    },
                    error: function (xhr) {
                        const endTime = performance.now();
                        const duration = Math.round(endTime - startTime);
                        $('#resTimeBadge').text(`${duration} ms`);
                        $('#resStatusBadge').attr('class', 'badge bg-danger font-monospace px-3 py-1.5').text(`HTTP ${xhr.status || 500} Error`);

                        let errJson = { statusCode: xhr.status || 500, error: xhr.statusText || 'Lỗi hệ thống' };
                        try {
                            errJson = JSON.parse(xhr.responseText);
                        } catch (e) { }

                        $('#jsonOutputConsole').text(JSON.stringify(errJson, null, 4));
                        updateSnippet();
                    }
                });
            });

            // NÚT SAO CHÉP JSON
            $('#btnCopyJson').on('click', function () {
                const txt = $('#jsonOutputConsole').text();
                navigator.clipboard.writeText(txt).then(function () {
                    showToast('Đã sao chép JSON Response!', 'fa-solid fa-copy');
                });
            });

            function updateSnippet() {
                const op = $('#apiEndpointSelect').val();
                const lang = $('#snippetLanguageSelect').val();
                const host = window.location.origin;
                let fullUrl = host + '/api/SachApi';
                let code = '';

                if (op === 'GET_BY_ID') fullUrl += '/GetById/1';
                else if (op === 'POST_CREATE') fullUrl += '/Create';
                else if (op === 'PUT_UPDATE') fullUrl += '/Update/1';
                else if (op === 'DELETE') fullUrl += '/Delete/1';

                if (lang === 'FETCH') {
                    if (op.startsWith('GET')) {
                        code = `fetch('${fullUrl}')\n  .then(res => res.json())\n  .then(data => console.log(data));`;
                    } else {
                        code = `fetch('${fullUrl}', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  body: JSON.stringify({ TenSach: 'Sách mới' })\n}).then(res => res.json()).then(console.log);`;
                    }
                } else if (lang === 'CURL') {
                    code = `curl -X ${op.startsWith('GET') ? 'GET' : 'POST'} "${fullUrl}" -H "Accept: application/json"`;
                } else if (lang === 'CSHARP') {
                    code = `using var client = new HttpClient();\nvar response = await client.GetAsync("${fullUrl}");\nstring json = await response.Content.ReadAsStringAsync();`;
                }

                $('#snippetCodeBox').text(code);
            }

            // Khởi tạo snippet ban đầu
            updateSnippet();
        });
    </script>
}
