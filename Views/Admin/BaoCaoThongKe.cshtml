@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Báo cáo thống kê & doanh thu";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-file-chart-column text-purple me-2" style="color: #a855f7;"></i>Báo Cáo Thống Kê & Doanh Thu
            </h3>
            <p class="text-muted small mb-0">Thống kê chi tiết tình hình mượn trả, báo cáo doanh thu phạt và xuất dữ liệu.</p>
        </div>
        <button class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-file-export me-1"></i>Xuất Báo Cáo (Excel/PDF)
        </button>
    </div>

    <div class="glass-card p-4 rounded-4 border text-center py-5">
        <i class="fa-solid fa-chart-column fs-1 mb-3" style="color: #a855f7;"></i>
        <h4 class="fw-bold" style="color: var(--text-primary);">Giao Diện Xem Trước: Báo Cáo & Thống Kê Chuyên Sâu</h4>
        <p class="text-muted">Báo cáo doanh thu phạt, tổng hợp xu hướng mượn sách theo từng mốc thời gian.</p>
    </div>
</div>
