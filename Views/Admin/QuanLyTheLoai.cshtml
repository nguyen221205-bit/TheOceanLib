@model IEnumerable<DoAn_LTWeb.Models.TheLoai>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý danh mục Thể loại";
    string tuKhoa = ViewBag.TuKhoa as string ?? "";
}

<div class="container-fluid p-0">
    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-tags text-info me-2"></i>Quản Lý Danh Mục Thể Loại Sách
            </h3>
            <p class="text-muted small mb-0">Quản lý danh sách thể loại phân loại các đầu sách trong hệ thống thư viện.</p>
        </div>
        <button class="btn btn-info text-white rounded-pill px-4 py-2 fw-semibold shadow-sm" onclick="openAddTheLoaiModal()">
            <i class="fa-solid fa-plus me-2"></i>Thêm Thể Loại Mới
        </button>
    </div>

    <!-- FILTER & SEARCH BAR -->
    <div class="glass-card p-3 rounded-4 border mb-4">
        <form method="get" action="@Url.Action("QuanLyTheLoai", "Admin")" class="row g-2 align-items-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control border-start-0 ps-0" placeholder="Nhập tên thể loại cần tìm..." />
                </div>
            </div>
            <div class="col-12 col-md-4 col-lg-3 d-flex gap-2">
                <button type="submit" class="btn btn-info text-white flex-fill rounded-3 fw-semibold">
                    <i class="fa-solid fa-filter me-1"></i>Tìm kiếm
                </button>
                <a href="@Url.Action("QuanLyTheLoai", "Admin")" class="btn btn-outline-secondary rounded-3" title="Đặt lại filter">
                    <i class="fa-solid fa-rotate"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- MAIN DATA TABLE -->
    <div class="glass-card rounded-4 border overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-uppercase text-muted small fw-bold" style="letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4 py-3" style="width: 70px;">STT</th>
                        <th class="py-3" style="width: 120px;">Mã thể loại</th>
                        <th class="py-3">Tên thể loại</th>
                        <th class="py-3 text-center">Số đầu sách liên kết</th>
                        <th class="pe-4 py-3 text-end" style="width: 200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int stt = 1;
                        foreach (var item in Model)
                        {
                            int countSach = item.Sach != null ? item.Sach.Count : 0;
                            <tr>
                                <td class="ps-4 fw-semibold text-muted">@stt</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-15 text-dark fw-bold px-2 py-1">#TL@(item.MaTheLoai.ToString("D3"))</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-dark fs-6">@item.TenTheLoai</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(countSach > 0 ? "bg-primary" : "bg-light text-muted border") rounded-pill px-3 py-1">
                                        <i class="fa-solid fa-book me-1"></i>@countSach đầu sách
                                    </span>
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <!-- Nút Sửa -->
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-3" title="Chỉnh sửa thể loại" onclick="openEditTheLoaiModal(@item.MaTheLoai, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.TenTheLoai))')">
                                            <i class="fa-solid fa-pen-to-square me-1"></i>Sửa
                                        </button>
                                        <!-- Nút Xóa -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-3" title="Xóa thể loại" onclick="deleteTheLoai(@item.MaTheLoai, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.TenTheLoai))', @countSach)">
                                            <i class="fa-solid fa-trash-can me-1"></i>Xóa
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fs-1 mb-3 text-secondary d-block"></i>
                                Chưa có thể loại nào được tìm thấy.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= MODAL: THÊM / SỬA THỂ LOẠI ================= -->
<div class="modal fade" id="modalTheLoai" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content glass-card border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold" id="modalTheLoaiTitle">
                    <i class="fa-solid fa-tags text-info me-2"></i>Thêm Thể Loại Mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formTheLoai">
                <div class="modal-body p-4">
                    <input type="hidden" id="tl_MaTheLoai" value="0" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Thể Loại Sách <span class="text-danger">*</span></label>
                        <input type="text" class="form-control rounded-3" id="tl_TenTheLoai" required placeholder="VD: Lập trình Web, Trí tuệ nhân tạo..." />
                    </div>
                </div>
                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-semibold" id="btnSaveTheLoai">
                        <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Thể Loại
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAddTheLoaiModal() {
            $('#tl_MaTheLoai').val(0);
            $('#tl_TenTheLoai').val('');
            $('#modalTheLoaiTitle').html('<i class="fa-solid fa-plus-circle text-info me-2"></i>Thêm Thể Loại Mới');
            const modal = new bootstrap.Modal(document.getElementById('modalTheLoai'));
            modal.show();
        }

        function openEditTheLoaiModal(id, name) {
            $('#tl_MaTheLoai').val(id);
            $('#tl_TenTheLoai').val(name);
            $('#modalTheLoaiTitle').html('<i class="fa-solid fa-pen-to-square text-info me-2"></i>Chỉnh Sửa Thể Loại #' + id);
            const modal = new bootstrap.Modal(document.getElementById('modalTheLoai'));
            modal.show();
        }

        $('#formTheLoai').on('submit', function (e) {
            e.preventDefault();
            const id = $('#tl_MaTheLoai').val();
            const name = $('#tl_TenTheLoai').val().trim();

            if (!name) {
                alert('Vui lòng nhập tên thể loại!');
                return;
            }

            const actionUrl = id == 0 ? '@Url.Action("ThemTheLoai", "Admin")' : '@Url.Action("SuaTheLoai", "Admin")';
            const postData = id == 0 ? { tenTheLoai: name } : { maTheLoai: id, tenTheLoai: name };

            $('#btnSaveTheLoai').prop('disabled', true);

            $.ajax({
                url: actionUrl,
                type: 'POST',
                data: postData,
                success: function (res) {
                    $('#btnSaveTheLoai').prop('disabled', false);
                    if (res.success) {
                        alert(res.message);
                        location.reload();
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    $('#btnSaveTheLoai').prop('disabled', false);
                    alert('Lỗi máy chủ khi lưu thể loại!');
                }
            });
        });

        function deleteTheLoai(id, name, countSach) {
            if (countSach > 0) {
                alert('Không thể xóa thể loại "' + name + '" vì đang có ' + countSach + ' đầu sách thuộc thể loại này!');
                return;
            }

            if (confirm('Bạn có chắc chắn muốn xóa thể loại "' + name + '" không?')) {
                $.ajax({
                    url: '@Url.Action("XoaTheLoai", "Admin")',
                    type: 'POST',
                    data: { maTheLoai: id },
                    success: function (res) {
                        if (res.success) {
                            alert(res.message);
                            location.reload();
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        alert('Lỗi khi xóa thể loại!');
                    }
                });
            }
        }
    </script>
}
