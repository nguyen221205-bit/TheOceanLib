@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Quản lý Thể loại";
}

<div class="container-fluid p-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1" style="color: var(--text-primary);">
                <i class="fa-solid fa-layer-group text-info me-2"></i>Quản Lý Thể Loại Sách
            </h3>
            <p class="text-muted small mb-0">Quản lý danh mục thể loại sách trong hệ thống thư viện.</p>
        </div>
        <button class="btn btn-info text-white rounded-pill px-4 py-2 fw-semibold">
            <i class="fa-solid fa-plus me-1"></i>Thêm Thể Loại Mới
        </button>
    </div>

    <div class="glass-card p-4 rounded-4 border text-center py-5">
        <i class="fa-solid fa-tags fs-1 text-info mb-3"></i>
        <h4 class="fw-bold" style="color: var(--text-primary);">Giao Diện Xem Trước: Quản Lý Thể Loại</h4>
        <p class="text-muted">Quản lý danh mục Thể Loại với thao tác Thêm / Sửa / Xóa nhanh qua AJAX.</p>
    </div>
</div>
