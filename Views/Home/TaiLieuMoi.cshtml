@model IEnumerable<DoAn_LTWeb.Models.Sach>
@{
    ViewBag.Title = "TaiLieuMoi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .new-book-header {
        text-align: center;
        margin: 30px 0;
    }

        .new-book-header h2 {
            color: #25d0ff;
            font-weight: bold;
            font-size: 38px;
        }

        .new-book-header p {
            color: #b8c6db;
        }

    .search-box {
        display: flex;
        gap: 15px;
        margin: 30px auto;
        justify-content: center;
        flex-wrap: wrap;
    }

        .search-box input {
            width: 350px;
            border-radius: 30px;
            padding: 12px 20px;
        }

        .search-box select {
            width: 220px;
            border-radius: 30px;
        }

    .btn-search {
        border: none;
        background: #1fb6ff;
        color: white;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: bold;
        transition: .3s;
    }

        .btn-search:hover {
            background: #00d2ff;
        }
</style>

<div class="new-book-header">
    <h2>🆕 Tài liệu mới</h2>
    <p>Khám phá những tài liệu vừa được cập nhật vào thư viện.</p>
</div>

@using (Html.BeginForm("TaiLieuMoi", "Home", FormMethod.Get, new { @class = "search-box" }))
{
    <input type="text"
           name="tuKhoa"
           class="form-control"
           placeholder="🔍 Tìm theo tên sách..." />

    <select name="maTheLoai" class="form-select">
        <option value="">📚 Tất cả thể loại</option>

        @foreach (var tl in ViewBag.DanhSachTheLoai)
        {
            <option value="@tl.MaTheLoai">@tl.TenTheLoai</option>
        }
    </select>

    <button class="btn-search">
        Tìm kiếm
    </button>
}

<div class="row g-4">
    @foreach (var s in Model)
    {
        <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm border-0">
                <div class="book-card-img-wrapper" style="height: 300px; overflow: hidden; background-color: var(--bg-app); position: relative;">
                    <img src="~/Content/HinhAnh/@s.AnhBia"
                         class="card-img-top w-100 h-100"
                         style="object-fit: cover; object-position: center; transition: transform var(--transition-speed) ease;"
                         alt="@s.TenSach" />
                    <span class="new-badge" style="position: absolute; top: 12px; right: 12px; background: #ff3d57; color: white; padding: 6px 12px; border-radius: 20px; font-size: 13px; font-weight: bold; z-index: 2;">
                        🆕 MỚI
                    </span>
                </div>

                <div class="card-body d-flex flex-column gap-2 p-3">
                    <h5 class="card-title text-truncate mb-0 fs-6 fw-bold" title="@s.TenSach" style="color: var(--primary);">
                        @s.TenSach
                    </h5>
                    <div class="book-author text-secondary small" style="color: var(--text-secondary);">
                        <i class="fa-regular fa-user me-1 text-accent"></i>
                        <span>@(s.TacGia != null ? s.TacGia.TenTacGia : "Chưa cập nhật")</span>
                    </div>
                    <div class="book-quantity text-muted small mt-auto" style="color: var(--text-muted);">
                        <i class="fa-solid fa-boxes-stacked me-1"></i>
                        <span>Sẵn có: @s.SoLuongChuaMuon / @(s.TongSoLuong.HasValue ? s.TongSoLuong.Value.ToString() : "0")</span>
                    </div>
                </div>

                <div class="card-footer text-center p-3 bg-transparent border-top-0 d-flex gap-2 justify-content-center align-items-center">
                    @Html.ActionLink("Chi tiết",
                                     "ChiTietSach",
                                     new { id = s.MaSach },
                                     new { @class = "btn btn-outline-primary btn-sm flex-grow-1" })

                    <!-- Nút Thêm giỏ (AJAX) -->
                    <button type="button"
                            class="btn btn-success btn-sm btn-chon-sach flex-grow-1"
                            data-id="@s.MaSach">
                        Thêm giỏ
                    </button>

                    <!-- Nút Yêu thích (Client-side) -->
                    <button type="button"
                            class="btn btn-outline-danger btn-sm btn-them-yeu-thich px-2.5"
                            data-id="@s.MaSach"
                            data-title="@s.TenSach"
                            data-author="@(s.TacGia != null ? s.TacGia.TenTacGia : "Chưa cập nhật")"
                            data-img="@Url.Content("~/Content/HinhAnh/" + s.AnhBia)"
                            title="Thêm yêu thích">
                        <i class="fa-regular fa-heart"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Đánh dấu các sách đã có trong Danh sách Yêu thích khi tải trang
        const favList = JSON.parse(localStorage.getItem('favList')) || [];
        $('.btn-them-yeu-thich').each(function() {
            const btn = $(this);
            const id = parseInt(btn.data('id'));
            if (favList.some(item => item.id === id)) {
                btn.find('i').removeClass('fa-regular').addClass('fa-solid text-danger');
            }
        });

        $(document).on('click', '.btn-chon-sach', function (e) {
            e.preventDefault();

            var maSach = $(this).data('id');

            $.ajax({
                url: '/Home/ChonSach',
                type: 'POST',
                data: { id: maSach },
                success: function (response) {
                    if (response.success) {
                        $('#cartBadge').text(response.totalCount);
                        alert('Đã thêm sách vào giỏ mượn!');
                    } else {
                        alert(response.message || 'Có lỗi xảy ra!');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX:", error);
                    alert('Không thể kết nối đến máy chủ.');
                }
            });
        });

        // Click handler cho nút Yêu thích
        $(document).on('click', '.btn-them-yeu-thich', function (e) {
            e.preventDefault();
            var btn = $(this);
            var id = parseInt(btn.data('id'));
            var title = btn.data('title');
            var author = btn.data('author');
            var img = btn.data('img');
            
            // Thay đổi icon sang hình tim đỏ
            btn.find('i').removeClass('fa-regular').addClass('fa-solid text-danger');
            
            if (typeof window.addToFav === 'function') {
                window.addToFav(id, title, author, img);
            }
        });
    });
</script>
