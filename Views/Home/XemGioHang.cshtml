@using DoAn_LTWeb.Models
@model GioHang

@{
    ViewBag.Title = "Giỏ Hàng Mượn Sách";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-4">
    <h2 class="mb-4 text-emerald"><i class="fa-solid fa-basket-shopping me-2"></i>Chi Tiết Giỏ Mượn Sách</h2>

    @if (Model == null || Model.lst.Count == 0)
    {
        <div class="alert alert-info text-center py-4">
            <p class="fs-5 mb-3">Giỏ hàng mượn của bạn đang trống!</p>
            <a href="@Url.Action("HienThiDSSP", "Home")" class="btn btn-primary">
                <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách sách
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Hình ảnh</th>
                        <th scope="col">Tên sách</th>
                        <th scope="col" class="text-center" style="width: 180px;">Số lượng</th>
                        <th scope="col" class="text-center" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CartItem item in Model.lst)
                    {
                        <tr>
                            <td>
                                <img src="~/Content/HinhAnh/@item.sAnhBia" alt="@item.sTenSach" style="width: 60px; height: 80px; object-fit: cover; border-radius: 4px;" />
                            </td>
                            <td>
                                <span class="fw-bold" style="color: var(--primary);">@item.sTenSach</span>
                            </td>

                            <!-- Cột Số lượng có nút + - và AJAX -->
                            <td class="text-center">
                                <div class="d-flex align-items-center justify-content-center gap-1">
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-change-qty" data-id="@item.iMaSach" data-change="-1" style="width: 30px; height: 30px; border-radius: 4px; padding: 0;">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                    <input type="text" 
                                           id="qty-@item.iMaSach"
                                           value="@item.iSoLuong" 
                                           class="form-control form-control-sm text-center fw-bold" 
                                           style="width: 45px; height: 30px;" 
                                           readonly />
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-change-qty" data-id="@item.iMaSach" data-change="1" style="width: 30px; height: 30px; border-radius: 4px; padding: 0;">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                </div>
                            </td>

                            <!-- Cột Thao tác chứa nút Xóa -->
                            <td class="text-center">
                                <a href="@Url.Action("XoaGioHang", "Home", new { id = item.iMaSach })"
                                   class="btn btn-outline-danger btn-sm"
                                   onclick="return confirm('Bạn có chắc muốn xóa cuốn sách này khỏi giỏ mượn?');"
                                   title="Xóa sách">
                                    <i class="fa-solid fa-trash-can"></i> Xóa
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light">
                        <td colspan="2" class="fw-bold fs-5">Tổng số lượng mượn:</td>
                        <td id="totalCartQty" class="text-center fw-bold fs-5 text-emerald">@Model.TongSLHang()</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <a href="@Url.Action("HienThiDSSP", "Home")" class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i> Tiếp tục chọn sách
            </a>

            <a href="@Url.Action("XacNhanMuon", "Home")" class="btn btn-success btn-lg">
                <i class="fa-regular fa-square-check me-1"></i> Xác nhận mượn sách
            </a>
        </div>
    }
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('.btn-change-qty').on('click', function (e) {
            e.preventDefault();
            var btn = $(this);
            var id = btn.data('id');
            var change = parseInt(btn.data('change'));
            var row = btn.closest('tr');
            
            $.ajax({
                url: '/Home/CapNhatSoLuongAjax',
                type: 'POST',
                data: { id: id, change: change },
                success: function (response) {
                    if (response.success) {
                        // Cập nhật Badge trên Header
                        $('#cartBadge').text(response.totalQty);
                        
                        if (response.removed) {
                            // Xóa dòng tr khỏi bảng
                            row.fadeOut(300, function () {
                                $(this).remove();
                                // Nếu giỏ hàng trống sau khi xóa, reload để hiển thị thông báo giỏ hàng trống
                                if (response.totalQty === 0) {
                                    location.reload();
                                } else {
                                    // Cập nhật tổng số lượng hiển thị ở tfoot
                                    $('#totalCartQty').text(response.totalQty);
                                }
                            });
                        } else {
                            // Cập nhật ô số lượng
                            $('#qty-' + id).val(response.newQty);
                            // Cập nhật tổng số lượng hiển thị ở tfoot
                            $('#totalCartQty').text(response.totalQty);
                        }
                    } else {
                        alert(response.message || 'Có lỗi xảy ra!');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Lỗi AJAX:", error);
                    alert('Không thể kết nối đến máy chủ.');
                }
            });
        });
    });
</script>
